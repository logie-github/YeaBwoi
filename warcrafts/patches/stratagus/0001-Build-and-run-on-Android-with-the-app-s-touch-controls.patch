+#ifdef __ANDROID__
+/**
+**  The Warcraft app's touch controls: a tap is a right click. On the battlefield it gives orders
+**  to what's selected; where a right click would do nothing (the menus, the panel's buttons, the
+**  map with none of the player's units selected) it's the left click, which does something there:
+**  a tap presses a button, or selects the unit under the finger.
+**  The release goes as the press went.
+*/
+static Uint8 TouchButtonPress(Uint8 button, Uint8 &pressedAs)
+{
+	pressedAs = button;
+	if (button != SDL_BUTTON_RIGHT) {
+		return button;
+	}
+	const bool battlefield = GameRunning && GetCallbacks() == &GameCallbacks
+		&& (CursorOn == ECursorOn::Map || CursorOn == ECursorOn::Minimap);
+	const bool orders = !Selected.empty() && Selected[0]->Player == ThisPlayer;
+	if (!battlefield || (CursorOn == ECursorOn::Map && !orders)) {
+		pressedAs = SDL_BUTTON_LEFT;
+	}
+	return pressedAs;
+}
+
+static Uint8 TouchRightPressedAs = SDL_BUTTON_RIGHT;
+#endif
