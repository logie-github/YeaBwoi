diff --git a/CMakeLists.txt b/CMakeLists.txt
index d7a0d4b..b167ac3 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -14,6 +14,16 @@ if(CMAKE_CROSSCOMPILING OR CMAKE_TOOLCHAIN_FILE)
       -DCMAKE_TOOLCHAIN_FILE:FILEPATH=${CMAKE_TOOLCHAIN_FILE}
     )
   endif()
+  if(ANDROID)
+    # The NDK's toolchain needs the ABI, platform and STL in every project it configures.
+    list(APPEND STRATAGUS_EXTERNAL_CMAKE_ARGS
+      -DANDROID_ABI:STRING=${ANDROID_ABI}
+      -DANDROID_PLATFORM:STRING=${ANDROID_PLATFORM}
+      -DANDROID_STL:STRING=${ANDROID_STL}
+      -DCMAKE_MAKE_PROGRAM:FILEPATH=${CMAKE_MAKE_PROGRAM}
+      -DCMAKE_BUILD_TYPE:STRING=${CMAKE_BUILD_TYPE}
+    )
+  endif()
   if(CMAKE_RC_COMPILER)
     list(APPEND STRATAGUS_EXTERNAL_CMAKE_ARGS
       -DCMAKE_RC_COMPILER:FILEPATH=${CMAKE_RC_COMPILER}
@@ -101,6 +111,8 @@ macro(vendored_png)
       CMAKE_ARGS ${STRATAGUS_EXTERNAL_CMAKE_ARGS}
       CMAKE_CACHE_ARGS -DZLIB_FOUND:STRING=1 -DZLIB_INCLUDE_DIR:PATH=${ZLIB_INCLUDE_DIR} -DZLIB_LIBRARY:FILEPATH=${ZLIB_LIBRARIES}
       -DCMAKE_POSITION_INDEPENDENT_CODE:BOOL=ON
+      # Only the static library is used (its shared one needs a generated version script).
+      -DPNG_SHARED:BOOL=OFF -DPNG_TESTS:BOOL=OFF
     )
 
     add_dependencies(png zlib)
