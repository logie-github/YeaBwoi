# Warcraft I and II, native on Android: the Stratagus engine (GPL-2.0) with War1gus and Wargus (the
# games' scripts and the tools that turn the user's GOG files into their data), built for arm64 by
# scripts/build-stratagus.sh with warcrafts/patches/stratagus*/ applied. The pins are the engine's
# master and the game packages that go with it (as the Quest port xr.wargus pairs them).
STRATAGUS_REPO=https://github.com/Wargus/stratagus
STRATAGUS_COMMIT=3d87c93f7fd8c0b62ee1be5df0a6d9efc72ca6cc
WARGUS_REPO=https://github.com/Wargus/wargus
WARGUS_COMMIT=cde1a0718a0058cc651ecd56ff8149fc39f624e9
WAR1GUS_REPO=https://github.com/Wargus/war1gus
WAR1GUS_COMMIT=8ec75764c7b4706a4405004438e810c050228b94
# The NDK it's built with (the one Winlator's code in this app uses).
STRATAGUS_NDK=24.0.8215888
