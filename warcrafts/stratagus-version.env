# Warcraft I and II, native on Android: the Stratagus engine (GPL-2.0) with War1gus and Wargus (the
# games' scripts and the tools that turn the user's GOG files into their data), built for arm64 by
# scripts/build-stratagus.sh with warcrafts/patches/stratagus*/ applied. The pins are the engine's
# master and the game packages that go with it (as the Quest port xr.wargus pairs them).
STRATAGUS_REPO=https://github.com/Wargus/stratagus
STRATAGUS_COMMIT=3d87c93f7fd8c0b62ee1be5df0a6d9efc72ca6cc
WARGUS_REPO=https://github.com/Wargus/wargus
WARGUS_COMMIT=cde1a0718a0058cc651ecd56ff8149fc39f624e9
WAR1GUS_REPO=https://github.com/Wargus/war1gus
WAR1GUS_COMMIT=8ec75764c7b4706a4405004438e810c050228b94
# The NDK it's built with (the one Winlator's code in this app uses).
STRATAGUS_NDK=24.0.8215888
# innoextract, which unpacks GOG's offline installers (setup_*.exe and their .bin parts) on the
# phone: crazy-max's fork at its v1.13.0 (upstream's master reads Inno Setup only up to 6.4.0; the
# fork has dscharrer/innoextract#210, Inno Setup 6.4.2 to 7.0, which GOG's newer installers are
# made with), with Boost and liblzma (xz, a release after the 5.6.0/5.6.1 backdoor) built for Android.
INNOEXTRACT_REPO=https://github.com/crazy-max/innoextract
INNOEXTRACT_COMMIT=21e1fd97083baf2c1ce41afb547ae6d273f4fcfb
BOOST_URL=https://archives.boost.io/release/1.84.0/source/boost_1_84_0.tar.bz2
BOOST_SHA256=cc4b893acf645c9d4b698e9a0f08ca8846aa5d6c68275c14c3e7949c24109454
XZ_URL=https://github.com/tukaani-project/xz/releases/download/v5.6.3/xz-5.6.3.tar.gz
XZ_SHA256=b1d45295d3f71f25a4c9101bd7c8d16cb56348bbef3bbc738da0351e17c73317
