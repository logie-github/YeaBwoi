From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Azure Dreams <azuredreams@users.noreply.github.com>
Date: Fri, 9 Oct 2026 16:46:35 +0000
Subject: [PATCH 3/4] Cores that draw with OpenGL: OpenGL ES contexts only,
 framebuffer at the frames' size, their state put back

What SwanStation (and any core like it) needs:

- SET_HW_RENDER refuses context types other than OpenGL ES. The context is
  always OpenGL ES, and cores that try desktop OpenGL first only go on to ask
  for OpenGL ES when that's refused.
- The framebuffer follows the size of the frames the core draws, which can
  change without SET_GEOMETRY (with the game's display mode, or the internal
  resolution). It's resized when the core next asks for it, before drawing.
- Before drawing the core's frame, the state the shader passes rely on is put
  back. SwanStation hands its frame over with its vertex array object still
  bound, and client-side vertex arrays draw nothing then: the screen stayed
  black.
---
 libretrodroid/src/main/cpp/environment.cpp    | 12 ++++++++++
 .../cpp/renderers/es3/framebufferrenderer.cpp | 13 +++++++++++
 libretrodroid/src/main/cpp/video.cpp          | 22 ++++++++++++++++++-
 libretrodroid/src/main/cpp/video.h            |  2 ++
 4 files changed, 48 insertions(+), 1 deletion(-)

diff --git a/libretrodroid/src/main/cpp/environment.cpp b/libretrodroid/src/main/cpp/environment.cpp
index 941de81..2729ed5 100644
--- a/libretrodroid/src/main/cpp/environment.cpp
+++ b/libretrodroid/src/main/cpp/environment.cpp
@@ -146,6 +146,18 @@ bool Environment::environment_handle_set_controller_info(const struct retro_cont
 }
 
 bool Environment::environment_handle_set_hw_render(struct retro_hw_render_callback* hw_render_callback) {
+    // The context is always OpenGL ES. Refusing the other kinds lets cores that ask for desktop
+    // OpenGL first (SwanStation) go on to ask for OpenGL ES.
+    switch (hw_render_callback->context_type) {
+        case RETRO_HW_CONTEXT_OPENGLES2:
+        case RETRO_HW_CONTEXT_OPENGLES3:
+        case RETRO_HW_CONTEXT_OPENGLES_VERSION:
+            break;
+        default:
+            LOGD("Refusing hardware context type %d", hw_render_callback->context_type);
+            return false;
+    }
+
     useHWAcceleration = true;
     useDepth = hw_render_callback->depth;
     useStencil = hw_render_callback->stencil;
diff --git a/libretrodroid/src/main/cpp/renderers/es3/framebufferrenderer.cpp b/libretrodroid/src/main/cpp/renderers/es3/framebufferrenderer.cpp
index 67d009c..fbbb562 100644
--- a/libretrodroid/src/main/cpp/renderers/es3/framebufferrenderer.cpp
+++ b/libretrodroid/src/main/cpp/renderers/es3/framebufferrenderer.cpp
@@ -44,6 +44,15 @@ void FramebufferRenderer::onNewFrame(const void *data, unsigned width, unsigned
         initializeBuffers();
         isDirty = false;
     }
+
+    // Cores can change the size they draw at without SET_GEOMETRY (SwanStation does, with the
+    // game's display mode and its internal resolution): the framebuffer follows the frames. It's
+    // resized when the core next asks for it, before it draws.
+    if (width != this->width || height != this->height) {
+        this->width = width;
+        this->height = height;
+        isDirty = true;
+    }
 }
 
 void FramebufferRenderer::initializeBuffers() {
@@ -65,6 +74,10 @@ uintptr_t FramebufferRenderer::getTexture() {
 }
 
 uintptr_t FramebufferRenderer::getFramebuffer() {
+    if (isDirty) {
+        initializeBuffers();
+        isDirty = false;
+    }
     return framebuffer->framebuffer;
 }
 
