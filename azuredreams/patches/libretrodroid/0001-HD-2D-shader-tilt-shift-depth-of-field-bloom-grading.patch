--- a/libretrodroid/src/main/cpp/shadermanager.cpp
+++ b/libretrodroid/src/main/cpp/shadermanager.cpp
@@ -17,6 +17,9 @@
 
 #include "shadermanager.h"
 
+#include <algorithm>
+#include <cstdlib>
+
 namespace libretrodroid {
 
 const std::string ShaderManager::defaultShaderVertex =
@@ -1527,6 +1530,240 @@ const std::string ShaderManager::cut3UpscalePass2Fragment =
     "  gl_FragColor = vec4(final.rgb, 1.0);\n"
     "}";
 
+// HD-2D: Octopath Traveler-style post-processing for 2D sprites in 3D scenes. The game's pixels stay
+// sharp; a soft copy of the frame is blended in toward the top and bottom (tilt-shift depth of
+// field), its bright parts glow, and the colors are graded and vignetted. Made for Azure Dreams: its
+// interface stays sharp on top of the effects (lettering on its windows' dark blue fill, the deep
+// navy of the tower's gauges, the gauge strip, and the dialogue window with its name plate and the
+// speaker's portrait) while the scene around it keeps its depth of field. Blur sizes follow the
+// core's internal resolution.
+
+const std::unordered_map<std::string, std::string> ShaderManager::hd2dParams = {
+    { "TEXT_MIN_LIGHT", "0.62" },
+    { "TEXT_MAX_TINT", "0.3" },
+    { "NAVY_MAX_LIGHT", "0.13" },
+    { "NAVY_MIN_BLUE", "0.12" },
+    { "WINDOW_MAX_LIGHT", "0.32" },
+    { "WINDOW_BLUE_SLACK", "0.03" },
+    { "BLUR_ACROSS", "2.0" },
+    { "BLUR_DOWN", "1.5" },
+    { "GAUGES_BOTTOM", "0.23" },
+    { "DIALOGUE_MARGIN", "0.1" },
+    { "PORTRAIT_RIGHT", "0.38" },
+    { "FOCUS_CENTER", "0.55" },
+    { "FOCUS_HALF", "0.17" },
+    { "FOCUS_FADE", "0.28" },
+    { "DOF_TOP", "1.0" },
+    { "DOF_BOTTOM", "0.6" },
+    { "BLOOM", "0.5" },
+    { "BLOOM_THRESHOLD", "0.55" },
+    { "SATURATION", "1.18" },
+    { "CONTRAST", "1.06" },
+    { "WARMTH", "1.0" },
+    { "VIGNETTE", "0.35" },
+    { "RESOLUTION", "1" },
+};
+
+const std::string ShaderManager::hd2dPass0Fragment =
+    "#ifdef GL_FRAGMENT_PRECISION_HIGH\n"
+    "#define HIGHP highp\n"
+    "#else\n"
+    "#define HIGHP mediump\n"
+    "#endif\n"
+    "precision mediump float;\n"
+    "\n"
+    "uniform lowp sampler2D texture;\n"
+    "uniform HIGHP vec2 textureSize;\n"
+    "varying HIGHP vec2 coords;\n"
+    "\n"
+    "// The frame's size in PlayStation pixels: each one is drawn as a square of frame texels at the core's\n"
+    "// internal resolution.\n"
+    "HIGHP vec2 native;\n"
+    "// The middle of the first of the 2x2 PlayStation pixels this pixel covers.\n"
+    "HIGHP vec2 first;\n"
+    "\n"
+    "// A PlayStation pixel, counted from the first.\n"
+    "vec3 at(float x, float y) {\n"
+    "  return texture2D(texture, first + vec2(x, y) / native).rgb;\n"
+    "}\n"
+    "\n"
+    "float luma(vec3 c) {\n"
+    "  return dot(c, vec3(0.299, 0.587, 0.114));\n"
+    "}\n"
+    "\n"
+    "// White, nearly grey: the game's lettering.\n"
+    "float lettering(vec3 c) {\n"
+    "  float lo = min(c.r, min(c.g, c.b));\n"
+    "  float hi = max(c.r, max(c.g, c.b));\n"
+    "  return step(TEXT_MIN_LIGHT, lo) * step(hi - lo, TEXT_MAX_TINT);\n"
+    "}\n"
+    "\n"
+    "// Dark and leaning blue: the fill of the game's windows.\n"
+    "float windowFill(vec3 c) {\n"
+    "  return step(luma(c), WINDOW_MAX_LIGHT) * step(max(c.r, c.g) - WINDOW_BLUE_SLACK, c.b);\n"
+    "}\n"
+    "\n"
+    "// The deep navy inside the tower's gauges.\n"
+    "float navy(vec3 c) {\n"
+    "  return step(luma(c), NAVY_MAX_LIGHT) * step(c.r + NAVY_MIN_BLUE, c.b) * step(c.g + NAVY_MIN_BLUE * 0.6, c.b);\n"
+    "}\n"
+    "\n"
+    "// Lettering with window fill on both sides of it, across or down.\n"
+    "float text(float x, float y) {\n"
+    "  float near = 1.0;\n"
+    "  float far = 2.0;\n"
+    "  float across = max(windowFill(at(x - near, y)), windowFill(at(x - far, y)))\n"
+    "               * max(windowFill(at(x + near, y)), windowFill(at(x + far, y)));\n"
+    "  float down = max(windowFill(at(x, y - near)), windowFill(at(x, y - far)))\n"
+    "             * max(windowFill(at(x, y + near)), windowFill(at(x, y + far)));\n"
+    "  return lettering(at(x, y)) * max(across, down);\n"
+    "}\n"
+    "\n"
+    "void main() {\n"
+    "  native = textureSize / max(1.0, floor(textureSize.y / 224.0));\n"
+    "  first = (floor(coords * native * 0.5) * 2.0 + 0.5) / native;\n"
+    "  vec3 a = at(0.0, 0.0);\n"
+    "  vec3 b = at(1.0, 0.0);\n"
+    "  vec3 c = at(0.0, 1.0);\n"
+    "  vec3 d = at(1.0, 1.0);\n"
+    "  vec3 sum = a + b + c + d\n"
+    "           + at(-1.0, -1.0) + at(0.0, -1.0) + at(1.0, -1.0) + at(2.0, -1.0)\n"
+    "           + at(-1.0, 0.0) + at(2.0, 0.0) + at(-1.0, 1.0) + at(2.0, 1.0)\n"
+    "           + at(-1.0, 2.0) + at(0.0, 2.0) + at(1.0, 2.0) + at(2.0, 2.0);\n"
+    "  // A patch of navy, not a stray pixel of it. (Kept as separate steps: some shader compilers\n"
+    "  // get one nested expression of all of this wrong.)\n"
+    "  float navyCount = navy(a) + navy(b) + navy(c) + navy(d);\n"
+    "  float found = 0.5 * step(2.5, navyCount);\n"
+    "  found = max(found, text(0.0, 0.0));\n"
+    "  found = max(found, text(1.0, 0.0));\n"
+    "  found = max(found, text(0.0, 1.0));\n"
+    "  found = max(found, text(1.0, 1.0));\n"
+    "  gl_FragColor = vec4(sum / 16.0, found);\n"
+    "}\n";
+
+const std::string ShaderManager::hd2dPass1Fragment =
+    "#ifdef GL_FRAGMENT_PRECISION_HIGH\n"
+    "#define HIGHP highp\n"
+    "#else\n"
+    "#define HIGHP mediump\n"
+    "#endif\n"
+    "precision mediump float;\n"
+    "\n"
+    "uniform lowp sampler2D previousPass;\n"
+    "uniform HIGHP vec2 textureSize;\n"
+    "varying HIGHP vec2 coords;\n"
+    "\n"
+    "void main() {\n"
+    "  // In PlayStation pixels, whatever the internal resolution.\n"
+    "  float scale = max(1.0, floor(textureSize.y / 224.0));\n"
+    "  HIGHP vec2 offset = vec2(BLUR_ACROSS * 2.0 * scale / textureSize.x, 0.0);\n"
+    "  vec4 c0 = texture2D(previousPass, coords);\n"
+    "  vec4 c1 = texture2D(previousPass, coords + offset * 1.3846);\n"
+    "  vec4 c2 = texture2D(previousPass, coords - offset * 1.3846);\n"
+    "  vec4 c3 = texture2D(previousPass, coords + offset * 3.2308);\n"
+    "  vec4 c4 = texture2D(previousPass, coords - offset * 3.2308);\n"
+    "  vec3 color = c0.rgb * 0.2270 + (c1.rgb + c2.rgb) * 0.3162 + (c3.rgb + c4.rgb) * 0.0703;\n"
+    "  float found = max(c0.a, max(max(c1.a, c2.a), max(c3.a, c4.a)));\n"
+    "  gl_FragColor = vec4(color, found);\n"
+    "}\n";
+
+const std::string ShaderManager::hd2dPass2Fragment =
+    "#ifdef GL_FRAGMENT_PRECISION_HIGH\n"
+    "#define HIGHP highp\n"
+    "#else\n"
+    "#define HIGHP mediump\n"
+    "#endif\n"
+    "precision mediump float;\n"
+    "\n"
+    "uniform lowp sampler2D previousPass;\n"
+    "uniform HIGHP vec2 textureSize;\n"
+    "varying HIGHP vec2 coords;\n"
+    "\n"
+    "void main() {\n"
+    "  float scale = max(1.0, floor(textureSize.y / 224.0));\n"
+    "  HIGHP vec2 offset = vec2(0.0, BLUR_DOWN * 4.0 * scale / textureSize.y);\n"
+    "  vec4 c0 = texture2D(previousPass, coords);\n"
+    "  vec4 c1 = texture2D(previousPass, coords + offset * 1.3846);\n"
+    "  vec4 c2 = texture2D(previousPass, coords - offset * 1.3846);\n"
+    "  vec4 c3 = texture2D(previousPass, coords + offset * 3.2308);\n"
+    "  vec4 c4 = texture2D(previousPass, coords - offset * 3.2308);\n"
+    "  vec3 color = c0.rgb * 0.2270 + (c1.rgb + c2.rgb) * 0.3162 + (c3.rgb + c4.rgb) * 0.0703;\n"
+    "  float near = max(c0.a, max(max(c1.a, c2.a), max(c3.a, c4.a)));\n"
+    "  float onInterface = smoothstep(0.15, 0.4, near);\n"
+    "\n"
+    "  // The tower's gauges along the top, and the highest line of text in the lower half: the dialogue\n"
+    "  // window's (or its name plate's).\n"
+    "  float gauges = 0.0;\n"
+    "  float dialogueTop = 2.0;\n"
+    "  for (int y = 0; y < 15; y++) {\n"
+    "    for (int x = 0; x < 20; x++) {\n"
+    "      float found = texture2D(previousPass, (vec2(float(x), float(y)) + 0.5) / vec2(20.0, 15.0)).a;\n"
+    "      if (y < 3) {\n"
+    "        gauges = max(gauges, found);\n"
+    "      }\n"
+    "      if (y >= 8 && found > 0.75) {\n"
+    "        dialogueTop = min(dialogueTop, float(y) / 15.0);\n"
+    "      }\n"
+    "    }\n"
+    "  }\n"
+    "  gauges = step(0.3, gauges);\n"
+    "  // The window starts a little above its first line of text, and runs to the bottom. The speaker's\n"
+    "  // portrait stands on its left, above it.\n"
+    "  float dialogue = smoothstep(dialogueTop - DIALOGUE_MARGIN - 0.03, dialogueTop - DIALOGUE_MARGIN, coords.y);\n"
+    "  float portrait = step(dialogueTop, 1.0) * (1.0 - smoothstep(PORTRAIT_RIGHT, PORTRAIT_RIGHT + 0.06, coords.x));\n"
+    "  dialogue = max(dialogue, portrait);\n"
+    "\n"
+    "  float fromFocus = coords.y - FOCUS_CENTER;\n"
+    "  float depth = (fromFocus < 0.0 ? DOF_TOP : DOF_BOTTOM) * smoothstep(FOCUS_HALF, FOCUS_HALF + FOCUS_FADE, abs(fromFocus));\n"
+    "  // With the gauges up, the strip they're in stays sharp.\n"
+    "  depth *= 1.0 - gauges * (1.0 - smoothstep(GAUGES_BOTTOM, GAUGES_BOTTOM + 0.05, coords.y));\n"
+    "  gl_FragColor = vec4(color * (1.0 - onInterface), depth * (1.0 - onInterface) * (1.0 - dialogue));\n"
+    "}\n";
+
+const std::string ShaderManager::hd2dPass3Fragment =
+    "#ifdef GL_FRAGMENT_PRECISION_HIGH\n"
+    "#define HIGHP highp\n"
+    "#else\n"
+    "#define HIGHP mediump\n"
+    "#endif\n"
+    "precision mediump float;\n"
+    "\n"
+    "uniform lowp sampler2D texture;\n"
+    "uniform lowp sampler2D previousPass;\n"
+    "uniform HIGHP vec2 textureSize;\n"
+    "uniform mediump float screenDensity;\n"
+    "varying HIGHP vec2 coords;\n"
+    "varying HIGHP vec2 screenCoords;\n"
+    "\n"
+    "void main() {\n"
+    "  // The game's pixels, sharp (as in the Sharp picture).\n"
+    "  mediump vec2 threshold = vec2(1.0 / screenDensity);\n"
+    "  mediump vec2 f = fract(screenCoords);\n"
+    "  f = 0.5 * (smoothstep(vec2(0.0), threshold, f) + smoothstep(vec2(1.0) - threshold, vec2(1.0), f));\n"
+    "  vec3 color = texture2D(texture, (floor(screenCoords) + f) / textureSize).rgb;\n"
+    "\n"
+    "  // Depth of field.\n"
+    "  vec4 soft = texture2D(previousPass, coords);\n"
+    "  color = mix(color, soft.rgb, soft.a);\n"
+    "\n"
+    "  // Bloom: the bright parts of the soft copy glow over the picture.\n"
+    "  float softLuma = dot(soft.rgb, vec3(0.299, 0.587, 0.114));\n"
+    "  vec3 glow = soft.rgb * smoothstep(BLOOM_THRESHOLD, 1.0, softLuma) * BLOOM;\n"
+    "  color = 1.0 - (1.0 - color) * (1.0 - glow);\n"
+    "\n"
+    "  // Grading: richer color, a little more contrast, warm light and cool shade.\n"
+    "  float luma = dot(color, vec3(0.299, 0.587, 0.114));\n"
+    "  vec3 graded = mix(vec3(luma), color, SATURATION);\n"
+    "  graded = (graded - 0.5) * CONTRAST + 0.5;\n"
+    "  graded += mix(vec3(-0.012, 0.0, 0.03), vec3(0.035, 0.015, -0.025), smoothstep(0.15, 0.85, luma)) * WARMTH;\n"
+    "\n"
+    "  // Vignette.\n"
+    "  HIGHP vec2 fromCenter = (coords - 0.5) * vec2(1.0, 1.15);\n"
+    "  graded *= 1.0 - VIGNETTE * smoothstep(0.3, 0.78, length(fromCenter));\n"
+    "\n"
+    "  gl_FragColor = vec4(clamp(graded, 0.0, 1.0), 1.0);\n"
+    "}\n";
+
 ShaderManager::Chain ShaderManager::getShader(const ShaderManager::Config& config) {
     switch (config.type) {
     case Type::SHADER_DEFAULT: {
@@ -1602,6 +1839,27 @@ ShaderManager::Chain ShaderManager::getShader(const ShaderManager::Config& confi
             false
         };
     }
+
+    case Type::SHADER_HD2D: {
+        // The game's frame is read with linear filtering: exactly at texel centers for the
+        // soft copy, and between them for the sharp pixels' smoothed edges. The passes before the
+        // last work at the PlayStation's resolution, whatever the core's internal one (RESOLUTION).
+        std::string defines = buildDefines(hd2dParams, config.params);
+        float resolution = 1.0F;
+        auto found = config.params.find("RESOLUTION");
+        if (found != config.params.end()) {
+            resolution = std::max(1.0F, std::strtof(found->second.c_str(), nullptr));
+        }
+        return {
+            {
+                { defines + defaultShaderVertex, defines + hd2dPass0Fragment, true, 0.5F / resolution },
+                { defines + defaultShaderVertex, defines + hd2dPass1Fragment, true, 0.25F / resolution },
+                { defines + defaultShaderVertex, defines + hd2dPass2Fragment, true, 0.25F / resolution },
+                { defines + defaultShaderVertex, defines + hd2dPass3Fragment, true, 1.0 },
+            },
+            true
+        };
+    }
 }
 }
 
