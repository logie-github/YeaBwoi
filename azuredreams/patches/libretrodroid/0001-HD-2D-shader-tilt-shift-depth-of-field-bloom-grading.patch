diff --git a/libretrodroid/src/main/java/com/swordfish/libretrodroid/ShaderConfig.kt b/libretrodroid/src/main/java/com/swordfish/libretrodroid/ShaderConfig.kt
index 5bf4514..5d74543 100644
--- a/libretrodroid/src/main/java/com/swordfish/libretrodroid/ShaderConfig.kt
+++ b/libretrodroid/src/main/java/com/swordfish/libretrodroid/ShaderConfig.kt
@@ -24,6 +24,18 @@ sealed interface ShaderConfig {
     object LCD : ShaderConfig
     object Sharp : ShaderConfig
 
+    /**
+     * HD-2D post-processing (tilt-shift depth of field, bloom, color grading, vignette) over sharp
+     * pixels. Tuned for Azure Dreams, whose interface it keeps clear of the focus effects.
+     */
+    data class HD2D(
+        val depthOfField: Float = 1.0f,
+        val bloom: Float = 0.5f,
+        val vignette: Float = 0.35f,
+        /** The core's internal resolution, as a multiple of the console's. */
+        val resolution: Int = 1,
+    ) : ShaderConfig
+
     data class CUT(
         val useDynamicBlend: Boolean = true,
         val blendMinContrastEdge: Float = 0.0f,
