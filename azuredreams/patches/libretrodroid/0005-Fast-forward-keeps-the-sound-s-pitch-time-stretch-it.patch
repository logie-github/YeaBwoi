+ *     along with this program.  If not, see <https://www.gnu.org/licenses/>.
+ */
+
+#include "timestretch.h"
+
+#include <algorithm>
+#include <cmath>
+
+namespace libretrodroid {
+
+static size_t framesFor(int32_t sampleRate, double milliseconds) {
+    return std::max<size_t>(1, std::lround(sampleRate * milliseconds / 1000.0));
+}
+
+TimeStretch::TimeStretch(int32_t sampleRate): sampleRate(sampleRate) {
+    overlapFrames = framesFor(sampleRate, 8.0);
+    tail.resize(overlapFrames * 2);
+    tailShape.resize(overlapFrames);
+}
+
+void TimeStretch::configure(double newTempo) {
+    // Shorter pieces and a narrower search the faster it goes (the curve SoundTouch uses): 90 ms
+    // pieces searched over 20 ms at half speed, down to 40 ms over 15 ms from double speed up.
+    double t = std::clamp((newTempo - 0.5) / 1.5, 0.0, 1.0);
+    pieceFrames = std::max(framesFor(sampleRate, 90.0 - 50.0 * t), overlapFrames * 2 + 1);
+    seekFrames = framesFor(sampleRate, 20.0 - 5.0 * t);
+    skipFrames = newTempo * (double) (pieceFrames - overlapFrames);
+    tempo = newTempo;
+}
+
+void TimeStretch::process(const int16_t *data, size_t frames, double newTempo, std::vector<int16_t> &output) {
+    if (newTempo <= 1.0) {
+        if (active) {
+            fadeOutTail(data, frames, output);
+        } else {
+            output.insert(output.end(), data, data + frames * 2);
+        }
+        return;
+    }
+
+    if (!active || newTempo != tempo) {
+        configure(newTempo);
+    }
+    active = true;
+
+    for (size_t i = 0; i < frames * 2; i++) {
+        input.push_back(data[i] / 32768.0f);
+    }
+
+    while (true) {
+        size_t skip = (size_t) (skipFrames + skipRemainder);
+        size_t required = std::max(pieceFrames + seekFrames, skip);
+        if (input.size() / 2 < required) break;
+        processPiece(output);
+    }
+}
+
+void TimeStretch::processPiece(std::vector<int16_t> &output) {
+    size_t offset = hasTail ? findBestOffset() : 0;
+    const float *piece = input.data() + offset * 2;
+
+    for (size_t i = 0; i < overlapFrames; i++) {
+        float weight = hasTail ? (i + 0.5f) / overlapFrames : 1.0f;
+        for (size_t c = 0; c < 2; c++) {
+            float value = tail[i * 2 + c] * (1.0f - weight) + piece[i * 2 + c] * weight;
+            output.push_back(toSample(value));
+        }
+    }
+
+    for (size_t i = overlapFrames * 2; i < (pieceFrames - overlapFrames) * 2; i++) {
+        output.push_back(toSample(piece[i]));
+    }
+
+    const float *end = piece + (pieceFrames - overlapFrames) * 2;
+    std::copy(end, end + overlapFrames * 2, tail.begin());
+    for (size_t i = 0; i < overlapFrames; i++) {
+        float weight = (float) (i * (overlapFrames - i)) / (overlapFrames * overlapFrames * 0.25f);
+        tailShape[i] = (end[i * 2] + end[i * 2 + 1]) * weight;
+    }
+    hasTail = true;
+
+    double skip = skipFrames + skipRemainder;
+    auto wholeSkip = (size_t) skip;
+    skipRemainder = skip - (double) wholeSkip;
+    input.erase(input.begin(), input.begin() + (ptrdiff_t) (wholeSkip * 2));
+}
+
+// The offset, within the seek window, where the input looks most like the end of the previous
+// piece (normalized cross-correlation of the mono mix).
+size_t TimeStretch::findBestOffset() {
+    size_t length = seekFrames + overlapFrames;
+    inputShape.resize(length);
+    for (size_t i = 0; i < length; i++) {
+        inputShape[i] = input[i * 2] + input[i * 2 + 1];
+    }
+
+    double energy = 0.0;
+    for (size_t i = 0; i < overlapFrames; i++) {
+        energy += (double) inputShape[i] * inputShape[i];
+    }
+
+    size_t bestOffset = 0;
+    double bestScore = -1e30;
+    for (size_t offset = 0; offset < seekFrames; offset++) {
+        double correlation = 0.0;
+        const float *candidate = inputShape.data() + offset;
+        for (size_t i = 0; i < overlapFrames; i++) {
+            correlation += (double) tailShape[i] * candidate[i];
+        }
+
+        double score = correlation / std::sqrt(std::max(energy, 1e-9));
+        if (score > bestScore) {
+            bestScore = score;
+            bestOffset = offset;
+        }
+
+        double leaving = candidate[0];
+        double entering = candidate[overlapFrames];
+        energy += entering * entering - leaving * leaving;
+    }
+    return bestOffset;
+}
+
+// Back to normal speed: fade from the end of the last piece into the new audio and drop what was
+// still waiting, then pass the audio through.
+void TimeStretch::fadeOutTail(const int16_t *data, size_t frames, std::vector<int16_t> &output) {
+    size_t fadeFrames = hasTail ? std::min(frames, overlapFrames) : 0;
+    for (size_t i = 0; i < fadeFrames; i++) {
+        float weight = (i + 0.5f) / fadeFrames;
+        for (size_t c = 0; c < 2; c++) {
+            float value = tail[i * 2 + c] * (1.0f - weight) + data[i * 2 + c] / 32768.0f * weight;
+            output.push_back(toSample(value));
+        }
+    }
+    output.insert(output.end(), data + fadeFrames * 2, data + frames * 2);
+
+    active = false;
+    hasTail = false;
+    skipRemainder = 0.0;
+    input.clear();
+}
+
+int16_t TimeStretch::toSample(float value) {
+    return (int16_t) std::clamp(std::lround(value * 32768.0f), -32768L, 32767L);
+}
+
+} // namespace libretrodroid
