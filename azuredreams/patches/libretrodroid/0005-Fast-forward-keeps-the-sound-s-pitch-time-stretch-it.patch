+#ifndef LIBRETRODROID_TIMESTRETCH_H
+#define LIBRETRODROID_TIMESTRETCH_H
+
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+namespace libretrodroid {
+
+// Speeds stereo audio up without raising its pitch (WSOLA). The input is cut into short pieces
+// that overlap; between pieces it skips ahead, and each piece starts where its waveform best lines
+// up with the end of the previous one, so the joins don't click.
+class TimeStretch {
+public:
+    explicit TimeStretch(int32_t sampleRate);
+
+    // Appends the audio for these interleaved stereo frames, played tempo times faster, to output.
+    // At a tempo of 1 the audio goes through untouched.
+    void process(const int16_t *data, size_t frames, double tempo, std::vector<int16_t> &output);
+
+private:
+    void configure(double tempo);
+    void processPiece(std::vector<int16_t> &output);
+    size_t findBestOffset();
+    void fadeOutTail(const int16_t *data, size_t frames, std::vector<int16_t> &output);
+
+    static int16_t toSample(float value);
+
+private:
+    int32_t sampleRate;
+    size_t overlapFrames;
+    size_t pieceFrames = 0;
+    size_t seekFrames = 0;
+    double skipFrames = 0.0;
+    double skipRemainder = 0.0;
+    double tempo = 1.0;
+
+    bool active = false;
+    bool hasTail = false;
+
+    // Pending input, interleaved stereo, scaled to [-1, 1].
+    std::vector<float> input;
+    // The end of the previous piece, which the next one fades in over.
+    std::vector<float> tail;
+    // The same, mixed to mono and weighted toward its middle, to compare candidates against.
+    std::vector<float> tailShape;
+    std::vector<float> inputShape;
+};
+
+} // namespace libretrodroid
+
+#endif //LIBRETRODROID_TIMESTRETCH_H
