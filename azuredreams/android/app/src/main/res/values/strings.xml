    <!-- Controls -->
    <string name="ad_controls_title">Controls</string>
    <string name="ad_haptics">Vibrate on holds</string>
    <string name="ad_haptics_summary">A short buzz when a hold, L1, R1, Select or the menu gesture registers</string>
    <string name="ad_gesture_swipe">Swipe anywhere</string>
    <string name="ad_gesture_tap">Tap</string>
    <string name="ad_gesture_hold">Hold</string>
    <string name="ad_gesture_run">Hold, then drag (or hold and swipe with another finger)</string>
    <string name="ad_gesture_tap_hold">Tap, then tap and hold</string>
    <string name="ad_gesture_two_finger_swipe_down">Two fingers swipe down</string>
    <string name="ad_gesture_two_finger_swipe_up">Two fingers swipe up</string>
    <string name="ad_gesture_two_finger_swipe_sideways">Two fingers swipe right / left</string>
    <string name="ad_gesture_double_tap">Double tap</string>
    <string name="ad_gesture_two_finger_hold">Two-finger hold</string>
    <string name="ad_gesture_menu">Two-finger tap, then two-finger tap and hold</string>
    <string name="ad_gesture_back">Android\'s back gesture</string>
    <string name="ad_button_dpad">D-pad, any of 8 directions, held while your finger stays down: walk, pick in menus</string>
    <string name="ad_button_cross">Cross: attack, OK</string>
    <string name="ad_button_circle">Circle, held: cancel</string>
    <string name="ad_button_run">Circle and the D-pad: run</string>
    <string name="ad_button_shoulder">R1 on the right half of the screen, L1 on the left, held: turn the view</string>
    <string name="ad_button_square">Square: the game\'s menu</string>
    <string name="ad_button_triangle">Triangle: jump</string>
    <string name="ad_button_l1r1">L1 / R1</string>
    <string name="ad_button_start">Start: pause</string>
    <string name="ad_button_select">Select, held: the map</string>
    <string name="ad_button_menu">This app\'s menu: save states, speed, picture (pauses the game)</string>
    <string name="ad_gesture_note">Swipes press the D-pad as soon as they start, and follow your finger: the D-pad points where it last moved, so turning around is instant. Moving back to where the swipe started lets go. While one finger walks, a second can tap for Cross or hold for Circle.</string>

    <!-- Picture -->
    <string name="ad_picture_title">Picture</string>
    <string name="ad_hd2d">2D-HD</string>
    <string name="ad_hd2d_summary">Octopath-style: sharp pixels, tilt-shift depth of field, glow, richer color, drifting light. Takes the place of the Picture choice while it\'s on.</string>
    <string name="ad_hd2d_depth">Depth of field</string>
    <string name="ad_hd2d_depth_off">Off</string>
    <string name="ad_hd2d_depth_light">Light</string>
    <string name="ad_hd2d_depth_strong">Strong</string>
    <string name="ad_hd2d_depth_summary">The far top and near bottom of the scene go soft. Text, windows and the tower\'s gauges stay sharp, and while anyone\'s talking or a menu is open the whole picture comes into focus.</string>
    <string name="ad_hd2d_bloom">Glow</string>
    <string name="ad_hd2d_bloom_summary">Bright light softly blooms</string>
    <string name="ad_hd2d_motes">Drifting light</string>
    <string name="ad_hd2d_motes_summary">Specks of warm light floating up through the scene</string>
    <string name="ad_picture_sharp">Sharp pixels</string>
    <string name="ad_picture_sharp_summary">Crisp, unfiltered</string>
    <string name="ad_picture_smooth">Smooth</string>
    <string name="ad_picture_smooth_summary">Softened edges</string>
    <string name="ad_picture_crt">CRT TV</string>
    <string name="ad_picture_crt_summary">Scanlines, like the TVs of the day</string>
    <string name="ad_picture_upscaled">Upscaled</string>
    <string name="ad_picture_upscaled_summary">Smoothed edges, kept sharp</string>
    <string name="ad_sharper_3d">Sharper 3D</string>
    <string name="ad_sharper_3d_summary">Draws the 3D at twice the PlayStation\'s resolution. Uses more battery.</string>

    <!-- Memory card -->
    <string name="ad_card_title">Memory card</string>
    <string name="ad_card_status">Memory card 1, last saved %1$s</string>
    <string name="ad_card_empty">No saves yet. The game creates the card the first time you save.</string>
    <string name="ad_card_body">The game saves to memory card 1 like on a PlayStation, written to the phone as soon as it saves. Import a card from another emulator or a PlayStation (.mcd, .mcr, .srm, .gme, .vmp) to carry on from it; the card it replaces is kept as a backup. Export makes a copy (.mcd) that other emulators read.</string>
    <string name="ad_card_import">Import</string>
    <string name="ad_card_export">Export</string>
