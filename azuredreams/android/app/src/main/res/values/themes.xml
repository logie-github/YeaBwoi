<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AzureDreams" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@color/ad_night</item>
        <item name="colorPrimary">@color/ad_gold</item>
        <item name="colorOnPrimary">@color/ad_window_bottom</item>
        <item name="colorSurface">@color/ad_window_bottom</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.AzureDreams.Game">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <!-- The in-game menu and the update dialogs, over whatever screen opened them. -->
    <style name="Theme.AzureDreams.Overlay">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
