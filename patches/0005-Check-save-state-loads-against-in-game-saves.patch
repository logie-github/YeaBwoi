 namespace ExpansionInterface
 {
+static std::atomic<u64> s_last_write_time{0};
+
+static void NoteWrite()
+{
+  const auto now = std::chrono::system_clock::now().time_since_epoch();
+  s_last_write_time.store(std::chrono::duration_cast<std::chrono::milliseconds>(now).count(),
+                          std::memory_order_relaxed);
+}
+
+u64 CEXIMemoryCard::GetLastWriteTime()
+{
+  return s_last_write_time.load(std::memory_order_relaxed);
+}
+
