From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dolphin XD <dolphinxd@users.noreply.github.com>
Date: Wed, 7 Oct 2026 23:26:05 +0000
Subject: [PATCH 1/3] Rebrand Dolphin as Dolphin XD (com.logie.dolphinxd)

- New application ID, app name and launcher entry point (XdLauncherActivity).
- Dolphin XD's setup, main menu, texture pack and mod screens.
- Dolphin's game library activities are no longer launchable.
- Always keep user data in app-specific storage.
- Version code/name, ABIs and ccache can be set from Gradle properties.
---
 Source/Android/app/build.gradle.kts           | 27 ++++++--
 .../Android/app/src/main/AndroidManifest.xml  | 67 +++++++++++--------
 .../utils/DirectoryInitialization.kt          |  7 +-
 .../app/src/main/res/values/strings.xml       |  2 +-
 4 files changed, 64 insertions(+), 39 deletions(-)

diff --git a/Source/Android/app/build.gradle.kts b/Source/Android/app/build.gradle.kts
index 2fc4cb7..f60d7d9 100644
--- a/Source/Android/app/build.gradle.kts
+++ b/Source/Android/app/build.gradle.kts
@@ -5,6 +5,10 @@ plugins {
     alias(libs.plugins.androidx.baselineprofile)
 }
 
+// Phones only need arm64. Pass -PxdAbis=arm64-v8a,x86_64 for emulators/Chromebooks.
+val xdAbis = (project.findProperty("xdAbis")?.toString() ?: "arm64-v8a")
+    .split(",").map { it.trim() }
+
 @Suppress("UnstableApiUsage")
 android {
     compileSdk = 37
@@ -36,13 +40,21 @@ android {
     }
 
     defaultConfig {
-        applicationId = "org.dolphinemu.dolphinemu"
+        applicationId = "com.logie.dolphinxd"
         minSdk = 24
         targetSdk = 37
 
-        versionCode = getBuildVersionCode()
+        // CI passes -PxdVersionCode/-PxdVersionName so every build can be installed over the last.
+        versionCode = project.findProperty("xdVersionCode")?.toString()?.toInt()
+            ?: getBuildVersionCode()
+
+        versionName = project.findProperty("xdVersionName")?.toString() ?: getGitVersion()
 
-        versionName = getGitVersion()
+        // Also keeps libraries' prebuilt 32-bit code out, so unsupported devices refuse to
+        // install the APK instead of crashing on launch.
+        ndk {
+            abiFilters += xdAbis
+        }
 
         buildConfigField("String", "GIT_HASH", "\"${getGitHash()}\"")
         buildConfigField("String", "BRANCH", "\"${getBranch()}\"")
@@ -69,7 +81,7 @@ android {
                 signingConfig = signingConfigs.getByName("release")
             }
 
-            resValue("string", "app_name_suffixed", "Dolphin Emulator")
+            resValue("string", "app_name_suffixed", "Dolphin XD")
             isMinifyEnabled = true
             isShrinkResources = true
             proguardFiles(
@@ -81,7 +93,7 @@ android {
         // Signed by debug key disallowing distribution on Play Store.
         // Attaches "debug" suffix to version and package name, allowing installation alongside the release build.
         debug {
-            resValue("string", "app_name_suffixed", "Dolphin Debug")
+            resValue("string", "app_name_suffixed", "Dolphin XD Debug")
             applicationIdSuffix = ".debug"
             versionNameSuffix = "-debug"
             isJniDebuggable = true
@@ -105,7 +117,10 @@ android {
                     "-DCMAKE_BUILD_TYPE=RelWithDebInfo"
                     // , "-DENABLE_GENERIC=ON"
                 )
-                abiFilters("arm64-v8a", "x86_64") //, "armeabi-v7a", "x86"
+                if (project.hasProperty("xdCcache")) {
+                    arguments("-DENABLE_CCACHE=ON")
+                }
+                abiFilters(*xdAbis.toTypedArray())
 
                 // Uncomment the line below if you don't want to build the C++ unit tests
                 //targets("main", "hook_impl", "main_hook", "gsl_alloc_hook", "file_redirect_hook")
diff --git a/Source/Android/app/src/main/AndroidManifest.xml b/Source/Android/app/src/main/AndroidManifest.xml
