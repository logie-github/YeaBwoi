         <activity
             android:name=".activities.ConvertActivity"
diff --git a/Source/Android/app/src/main/java/org/dolphinemu/dolphinemu/utils/DirectoryInitialization.kt b/Source/Android/app/src/main/java/org/dolphinemu/dolphinemu/utils/DirectoryInitialization.kt
index 6d83254..bf73913 100644
--- a/Source/Android/app/src/main/java/org/dolphinemu/dolphinemu/utils/DirectoryInitialization.kt
+++ b/Source/Android/app/src/main/java/org/dolphinemu/dolphinemu/utils/DirectoryInitialization.kt
@@ -318,9 +318,10 @@ object DirectoryInitialization {
     }
 
     private fun preferLegacyUserDirectory(context: Context): Boolean {
-        return PermissionsHandler.isExternalStorageLegacy() && !PermissionsHandler.isWritePermissionDenied() && isExternalFilesDirEmpty(
-            context
-        ) && legacyUserDirectoryExists()
+        // Dolphin XD always keeps its data in its own app storage instead of sharing the
+        // /sdcard/dolphin-emu folder with a regular Dolphin install (and never asks for the
+        // storage permission that folder needs).
+        return false
     }
 
     @JvmStatic
