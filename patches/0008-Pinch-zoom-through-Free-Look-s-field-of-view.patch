 }
 
+// Pinch zoom: narrows Free Look's field of view. Only perspective projections change, so the
+// games' 2D menus and text stay as they are. Free Look is off whenever there is no zoom.
+JNIEXPORT void JNICALL Java_org_dolphinemu_dolphinemu_NativeLibrary_SetCameraZoom(JNIEnv*, jclass,
+                                                                                  jfloat zoom)
+{
+  const bool zoomed = zoom > 1.0f;
+  if (auto* controller = g_freelook_camera.GetController(); controller && controller->SupportsInput())
+    static_cast<CameraControllerInput*>(controller)->SetFovMultiplier(zoomed ? zoom : 1.0f);
+  // Only touch the config when it changes: every config change runs all of Dolphin's callbacks.
+  if (Config::Get(Config::FREE_LOOK_ENABLED) != zoomed)
+    Config::SetCurrent(Config::FREE_LOOK_ENABLED, zoomed);
+}
