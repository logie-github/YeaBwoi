+++ b/Source/Core/VideoCommon/FreeLookCamera.cpp
@@ -225,6 +225,13 @@ void CameraControllerInput::IncreaseFovY(float fov)
   m_fov_y_multiplier = std::max(m_fov_y_multiplier, MIN_FOV_MULTIPLIER);
 }
 
+void CameraControllerInput::SetFovMultiplier(float multiplier)
+{
+  m_fov_x_multiplier = std::max(multiplier, MIN_FOV_MULTIPLIER);
+  m_fov_y_multiplier = m_fov_x_multiplier;
+  m_dirty = true;
+}
