+ColorSurfaceCacheInfo *VKSurfaceCache::gold_find_color_surface(const uint32_t address) {
+    auto ite = color_address_lookup.upper_bound(address);
+    if (ite == color_address_lookup.begin())
+        return nullptr;
+    --ite;
+    if (ite->first + ite->second->total_bytes <= address)
+        return nullptr;
+    return ite->second;
+}
