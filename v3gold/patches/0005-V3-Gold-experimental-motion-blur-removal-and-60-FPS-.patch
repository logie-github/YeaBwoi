@@ -468,6 +545,20 @@ void draw(VKContext &context, SceGxmPrimitiveType type, SceGxmIndexFormat format
         memcpy(&context.prev_frag_ublock, &frag_ublock, sizeof(frag_ublock));
     }
 
+    // V3 Gold: Persona 4 Golden's motion blur
+    vk::DescriptorImageInfo gold_saved_texture{};
+    int gold_rebound_slot = -1;
+    if (instance_count == 1 && count <= 6 && frag_render_data->texture_count > 0) {
+        const gold::BlurAction gold_action = gold_check_readback(context,
+            *reinterpret_cast<const VKFragmentProgram *>(frag_render_data.get()),
+            frag_render_data->texture_count, gold_saved_texture, gold_rebound_slot);
+        if (gold_action == gold::BlurAction::Skipped) {
+            context.vertex_uniform_storage_allocated = false;
+            context.fragment_uniform_storage_allocated = false;
+            return;
+        }
+    }
+
     // create, update and bind descriptors (uniforms and textures)
     draw_bind_descriptors(context, mem);
 
@@ -504,6 +595,12 @@ void draw(VKContext &context, SceGxmPrimitiveType type, SceGxmIndexFormat format
 
     context.render_cmd.drawIndexed(count, instance_count, 0, 0, 0);
 
+    if (gold_rebound_slot >= 0) {
+        // the next draw uses the game's own binding again
+        context.fragment_textures[gold_rebound_slot] = gold_saved_texture;
+        context.last_frag_texture_count = ~0;
+    }
+
     context.vertex_uniform_storage_allocated = false;
     context.fragment_uniform_storage_allocated = false;
 }
