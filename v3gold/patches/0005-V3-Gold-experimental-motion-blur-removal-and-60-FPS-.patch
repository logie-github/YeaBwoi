+// V3 Gold: Persona 4 Golden's motion blur (see renderer/gold_lab.h). The game draws what it
+// rendered in the previous frame back over the new frame, partly transparent. This looks at a
+// full-screen draw sampling render targets, reports it to the in-game menu and, with the fix on:
+// - skips it if it blends a single earlier frame over the screen,
+// - or binds the new frame where it samples the earlier one if it mixes the two in its shader
+//   (rebound_slot is then the slot it changed, and saved_texture its original binding).
+static gold::BlurAction gold_check_readback(VKContext &context, const VKFragmentProgram &fragment_program,
+    const uint16_t texture_count, vk::DescriptorImageInfo &saved_texture, int &rebound_slot) {
+    const uint32_t target_address = context.record.color_surface.data.address();
+    const uint32_t target_width = context.record.color_surface.width;
+    const uint32_t target_height = context.record.color_surface.height;
+
+    int surface_count = 0;
+    int old_slot = -1;
+    int new_slot = -1;
+    uint64_t oldest_age = 0;
+    const ColorSurfaceCacheInfo *reported = nullptr;
+    for (uint16_t i = 0; i < std::min<uint16_t>(texture_count, SCE_GXM_MAX_TEXTURE_UNITS); i++) {
+        const uint32_t address = context.gold_frag_surface[i];
+        if (address == 0 || address == target_address)
+            continue;
+        const ColorSurfaceCacheInfo *surface = context.state.surface_cache.gold_find_color_surface(address);
+        if (surface == nullptr)
+            continue;
+
+        surface_count++;
+        const uint64_t age = context.frame_timestamp > surface->last_frame_rendered
+            ? context.frame_timestamp - surface->last_frame_rendered
+            : 0;
+        const bool full_size = surface->original_width == target_width && surface->original_height == target_height;
+        if (reported == nullptr || age > oldest_age)
+            reported = surface;
+        if (full_size && age >= 1 && (old_slot < 0 || age > oldest_age))
+            old_slot = i;
+        if (full_size && age == 0)
+            new_slot = i;
+        oldest_age = std::max(oldest_age, age);
+    }
+    if (surface_count == 0)
+        return gold::BlurAction::Kept;
+
+    const vk::PipelineColorBlendAttachmentState &blend = fragment_program.blending;
+    gold::BlurAction action = gold::BlurAction::Kept;
+    // only a frame drawn just before: older ones are still pictures, like a menu's background
+    const bool recent = old_slot >= 0 && oldest_age <= 2;
+    if (gold::lab().blur_fix.load(std::memory_order_relaxed) && recent) {
+        if (new_slot >= 0) {
+            saved_texture = context.fragment_textures[old_slot];
+            context.fragment_textures[old_slot] = context.fragment_textures[new_slot];
+            context.last_frag_texture_count = ~0;
+            rebound_slot = old_slot;
+            action = gold::BlurAction::Rebound;
+        } else if (surface_count == 1 && blend.blendEnable && blend.dstColorBlendFactor == vk::BlendFactor::eOneMinusSrcAlpha) {
+            action = gold::BlurAction::Skipped;
+        }
+    }
+
+    uint64_t hash = 0;
+    for (int i = 0; i < 8; i++)
+        hash = (hash << 8) | fragment_program.hash[i];
+    gold::ReadbackDraw report{};
+    report.fragment_hash = hash;
+    report.texture_count = texture_count;
+    report.width = static_cast<uint16_t>(target_width);
+    report.height = static_cast<uint16_t>(target_height);
+    report.frames_old = static_cast<uint16_t>(std::min<uint64_t>(oldest_age, 0xFFFF));
+    report.source_width = reported->original_width;
+    report.source_height = reported->original_height;
+    report.blending = static_cast<bool>(blend.blendEnable);
+    report.blend_src = static_cast<uint8_t>(blend.srcColorBlendFactor);
+    report.blend_dst = static_cast<uint8_t>(blend.dstColorBlendFactor);
+    report.action = action;
+    gold::lab().record(report);
+    return action;
+}
