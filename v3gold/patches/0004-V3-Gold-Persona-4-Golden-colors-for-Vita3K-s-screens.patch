From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: V3 Gold <v3gold@users.noreply.github.com>
Date: Thu, 8 Oct 2026 23:32:40 +0000
Subject: [PATCH 4/4] V3 Gold: Persona 4 Golden colors for Vita3K's screens

Settings, setup, the library, dialogs and the in-game menu use black and
TV yellow instead of Vita3K's gray and orange, and the window and splash
background is the same near-black.
---
 .../org/vita3k/emulator/ui/theme/Theme.kt     | 41 ++++++++++---------
 android/app/src/main/res/values/colors.xml    |  2 +-
 2 files changed, 22 insertions(+), 21 deletions(-)

diff --git a/android/app/src/main/java/org/vita3k/emulator/ui/theme/Theme.kt b/android/app/src/main/java/org/vita3k/emulator/ui/theme/Theme.kt
index 5cd1702..f6f2361 100644
--- a/android/app/src/main/java/org/vita3k/emulator/ui/theme/Theme.kt
+++ b/android/app/src/main/java/org/vita3k/emulator/ui/theme/Theme.kt
@@ -12,29 +12,30 @@ import androidx.compose.ui.platform.LocalView
 import androidx.compose.ui.window.DialogWindowProvider
 import androidx.core.view.WindowInsetsControllerCompat
 
-private val AppBackgroundColor = Color(0xFF111111)
-private val AppTopBarColor = Color(0xFF1C1C1C)
+// V3 Gold: Persona 4 Golden's black and TV yellow.
+private val AppBackgroundColor = Color(0xFF120F0B)
+private val AppTopBarColor = Color(0xFF1C1813)
 
 private val AppColorScheme = darkColorScheme(
-    primary = Color(0xFFFF9800),        
-    onPrimary = Color(0xFF1A0D00),
-    primaryContainer = Color(0xFF3D1F00),
-    onPrimaryContainer = Color(0xFFFFD8A8),
-    secondary = Color(0xFF9E9E9E),        
-    onSecondary = Color(0xFF1A1A1A),
-    secondaryContainer = Color(0xFF2C2C2C),
-    onSecondaryContainer = Color(0xFFE0E0E0),
-    tertiary = Color(0xFFBDBDBD),
-    onTertiary = Color(0xFF1A1A1A),
-    background = AppBackgroundColor,      
-    onBackground = Color(0xFFE8E8E8),
+    primary = Color(0xFFFFE500),
+    onPrimary = Color(0xFF1B1512),
+    primaryContainer = Color(0xFF4A3F00),
+    onPrimaryContainer = Color(0xFFFFF3A0),
+    secondary = Color(0xFFF2C318),
+    onSecondary = Color(0xFF1B1512),
+    secondaryContainer = Color(0xFF3A3220),
+    onSecondaryContainer = Color(0xFFFFE9A8),
+    tertiary = Color(0xFFFFF59D),
+    onTertiary = Color(0xFF1B1512),
+    background = AppBackgroundColor,
+    onBackground = Color(0xFFF5F0E0),
     surface = AppTopBarColor,
-    onSurface = Color(0xFFE8E8E8),
-    surfaceVariant = Color(0xFF2A2A2A),
-    onSurfaceVariant = Color(0xFFB0B0B0),
-    surfaceContainerHigh = Color(0xFF222222),
-    surfaceContainerHighest = Color(0xFF2A2A2A),
-    outline = Color(0xFF444444),
+    onSurface = Color(0xFFF5F0E0),
+    surfaceVariant = Color(0xFF2C261C),
+    onSurfaceVariant = Color(0xFFD8CFB4),
+    surfaceContainerHigh = Color(0xFF262017),
+    surfaceContainerHighest = Color(0xFF2E281D),
+    outline = Color(0xFF5A5040),
     error = Color(0xFFFF6B6B),
     onError = Color(0xFF1A0000)
 )
diff --git a/android/app/src/main/res/values/colors.xml b/android/app/src/main/res/values/colors.xml
index 358f9c0..d6113ad 100644
--- a/android/app/src/main/res/values/colors.xml
+++ b/android/app/src/main/res/values/colors.xml
@@ -1,4 +1,4 @@
 <?xml version="1.0" encoding="utf-8"?>
 <resources>
-    <color name="app_background">#111111</color>
+    <color name="app_background">#120F0B</color>
 </resources>
