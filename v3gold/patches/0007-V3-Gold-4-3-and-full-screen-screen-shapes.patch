                 display.viewport_x = 0.0f;
                 display.viewport_y = 0.0f;
                 display.viewport_w = fb_w;
@@ -1195,6 +1203,13 @@ void VKState::render_frame(DisplayState &display, const GxmState &gxm, MemState
             layout = vk::ImageLayout::eShaderReadOnlyOptimal;
         }
 
+        // V3 Gold: only the middle 4:3 of the picture for its 4:3 screen shape.
+        if (const float crop = gold::crop_fraction(static_cast<float>(viewport.width), static_cast<float>(viewport.height)); crop > 0.0f) {
+            const auto cut = static_cast<uint32_t>(viewport.width * crop);
