             && !(static_cast<int>(fb_w) % DEFAULT_RES_WIDTH)
             && !(static_cast<int>(fb_h) % (DEFAULT_RES_HEIGHT - 4));
 
-        if (stretch_the_display_area && !pixel_perfect) {
+        gold::ScreenRect gold_rect;
+        if (gold::screen_rect(gold::screen_shape(), fb_w, fb_h, gold_rect)) {
+            // V3 Gold's screen shape.
+            vp_pos = { gold_rect.x, gold_rect.y };
+            vp_size = { gold_rect.width, gold_rect.height };
+        } else if (stretch_the_display_area && !pixel_perfect) {
             vp_pos = { 0.0f, 0.0f };
             vp_size = { fb_w, fb_h };
         } else if ((window_aspect > vita_aspect) && !pixel_perfect) {
@@ -740,6 +746,20 @@ void GLState::render_frame(DisplayState &display, const GxmState &gxm, MemState
 
         glBindTexture(GL_TEXTURE_2D, last_texture);
 
+        // V3 Gold: only the middle 4:3 of the picture for its 4:3 screen shape.
+        if (const float crop = gold::crop_fraction(static_cast<float>(display_frame.image_size.x), static_cast<float>(display_frame.image_size.y)); crop > 0.0f) {
+            if (!need_uv) {
+                uvs[0] = 0.0f;
+                uvs[1] = 0.0f;
+                uvs[2] = 1.0f;
+                uvs[3] = 1.0f;
+                need_uv = true;
+            }
+            const float cut = (uvs[2] - uvs[0]) * crop;
+            uvs[0] += cut;
+            uvs[2] -= cut;
+        }
+
         screen_renderer.render(vp_pos, vp_size, need_uv ? uvs : nullptr, static_cast<GLuint>(surface_handle), texture_size, default_fbo);
     }
 
