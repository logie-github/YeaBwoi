+++ b/vita3k/renderer/include/renderer/vulkan/screen_filters.h
@@ -150,6 +150,8 @@ private:
 
     vk::Extent2D output_offset;
     vk::Extent2D output_size;
+    // The V3 Gold screen shape (gold::ScreenShape) the output is sized for.
+    int gold_shape = 0;
 
     vk::Sampler sampler;
 
diff --git a/vita3k/renderer/src/gl/renderer.cpp b/vita3k/renderer/src/gl/renderer.cpp
