<?xml version="1.0" encoding="utf-8"?>
<!-- Progress of an import or patch running in the background (XdTasks). -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/XdSetupCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="8dp"
    app:strokeColor="@color/xd_accent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/xd_task_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/xd_on_surface"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/xd_task_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/xd_on_surface_muted"
            android:textSize="13sp" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/xd_task_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:max="1000"
            app:indicatorColor="@color/xd_primary"
            app:trackColor="@color/xd_surface_stroke"
            app:trackCornerRadius="4dp"
            app:trackThickness="6dp" />

        <Button
            android:id="@+id/xd_task_cancel"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="4dp"
            android:text="@string/xd_task_cancel" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
