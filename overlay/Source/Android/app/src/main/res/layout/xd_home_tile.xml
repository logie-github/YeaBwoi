<?xml version="1.0" encoding="utf-8"?>
<!-- One main menu button. Icon, title and subtitle are set in XdHomeActivity. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/XdSetupCard"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    app:rippleColor="@color/xd_purple_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="112dp"
        android:orientation="vertical"
        android:padding="16dp">

        <ImageView
            android:id="@+id/xd_tile_icon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:importantForAccessibility="no"
            app:tint="@color/xd_purple_light" />

        <TextView
            android:id="@+id/xd_tile_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/xd_on_surface"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/xd_tile_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/xd_on_surface_muted"
            android:textSize="12sp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
