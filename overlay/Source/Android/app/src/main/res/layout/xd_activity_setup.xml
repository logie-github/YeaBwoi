<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/xd_setup_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/xd_background"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/xd_setup_content"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingVertical="24dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_max="600dp">

            <ImageView
                android:layout_width="132dp"
                android:layout_height="92dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/xd_logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/xd_app_name"
                android:textColor="@color/xd_on_surface"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:text="@string/xd_game_name"
                android:textColor="@color/xd_on_surface_muted"
                android:textSize="15sp" />

            <!-- Step 1: setup files -->
            <com.google.android.material.card.MaterialCardView
                style="@style/XdSetupCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/XdSetupCardTitle"
                        android:text="@string/xd_setup_files_title" />

                    <TextView
                        style="@style/XdSetupCardBody"
                        android:text="@string/xd_setup_files_body" />

                    <TextView
                        android:id="@+id/xd_bios_status"
                        style="@style/XdSetupCardStatus"
                        android:visibility="gone" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="end"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/xd_bios_skip"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:text="@string/xd_setup_files_skip" />

                        <Button
                            android:id="@+id/xd_bios_choose"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/xd_setup_files_choose" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Step 2: the game -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/xd_rom_card"
                style="@style/XdSetupCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/XdSetupCardTitle"
                        android:text="@string/xd_rom_title" />

                    <TextView
                        style="@style/XdSetupCardBody"
                        android:text="@string/xd_rom_body" />

                    <TextView
                        android:id="@+id/xd_rom_status"
                        style="@style/XdSetupCardStatus"
                        android:visibility="gone" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="end|center_vertical"
                        android:orientation="horizontal">

                        <ProgressBar
                            android:id="@+id/xd_progress"
                            style="?android:attr/progressBarStyleSmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="12dp"
                            android:indeterminateTint="@color/xd_red"
                            android:visibility="gone" />

                        <Button
                            android:id="@+id/xd_rom_choose"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/xd_rom_choose" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <Button
                android:id="@+id/xd_play"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="20dp"
                android:text="@string/xd_play"
                android:textSize="18sp"
                app:cornerRadius="16dp" />

            <!-- Controls cheat sheet -->
            <com.google.android.material.card.MaterialCardView
                style="@style/XdSetupCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/XdSetupCardTitle"
                        android:text="@string/xd_controls_title" />

                    <TextView
                        style="@style/XdSetupCardBody"
                        android:lineSpacingMultiplier="1.15"
                        android:text="@string/xd_controls_body" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>
