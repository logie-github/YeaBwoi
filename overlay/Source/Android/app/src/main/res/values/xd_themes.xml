<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dolphin XD palette: Shadow Lugia purple, XD red, black and white. -->
    <color name="xd_background">#0B0814</color>
    <color name="xd_background_scrim">#E60B0814</color>
    <color name="xd_surface">#171226</color>
    <color name="xd_surface_high">#211A33</color>
    <color name="xd_surface_stroke">#2E2448</color>
    <color name="xd_purple">#7B61D9</color>
    <color name="xd_purple_dark">#3B2C6E</color>
    <color name="xd_purple_light">#C9B8FF</color>
    <color name="xd_red">#E3262F</color>
    <color name="xd_red_dark">#7A0E15</color>
    <color name="xd_on_surface">#F4F1FB</color>
    <color name="xd_on_surface_muted">#ABA3C4</color>

    <style name="Theme.DolphinXD" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/xd_red</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">@color/xd_red_dark</item>
        <item name="colorOnPrimaryContainer">#FFDAD7</item>
        <item name="colorSecondary">@color/xd_purple_light</item>
        <item name="colorOnSecondary">#24124F</item>
        <item name="colorSecondaryContainer">@color/xd_purple_dark</item>
        <item name="colorOnSecondaryContainer">#E9E0FF</item>
        <item name="colorTertiary">@color/xd_purple_light</item>
        <item name="colorOnTertiary">#24124F</item>
        <item name="colorTertiaryContainer">@color/xd_purple_dark</item>
        <item name="colorOnTertiaryContainer">#E9E0FF</item>
        <item name="colorSurface">@color/xd_background</item>
        <item name="colorOnSurface">@color/xd_on_surface</item>
        <item name="colorSurfaceVariant">@color/xd_surface_stroke</item>
        <item name="colorOnSurfaceVariant">#CFC6E6</item>
        <item name="colorSurfaceContainerLowest">#08060F</item>
        <item name="colorSurfaceContainerLow">#120E1E</item>
        <item name="colorSurfaceContainer">@color/xd_surface</item>
        <item name="colorSurfaceContainerHigh">@color/xd_surface_high</item>
        <item name="colorSurfaceContainerHighest">#2A2140</item>
        <item name="colorOutline">#8D82AE</item>
        <item name="colorOutlineVariant">#3A3054</item>
        <item name="android:colorBackground">@color/xd_background</item>
        <item name="android:windowBackground">@color/xd_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.DolphinXD.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/xd_background</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/xd_icon_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.DolphinXD</item>
    </style>

    <style name="XdSetupCard" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/xd_surface</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="strokeColor">@color/xd_surface_stroke</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="XdSetupCardTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/xd_on_surface</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="XdSetupCardBody">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:textColor">@color/xd_on_surface_muted</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="XdSetupCardStatus">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:textColor">@color/xd_on_surface</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="XdSectionTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textColor">@color/xd_purple_light</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <style name="XdHint">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:textColor">@color/xd_on_surface_muted</item>
        <item name="android:textSize">13sp</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>

    <style name="XdToolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@android:color/transparent</item>
        <item name="titleTextColor">@color/xd_on_surface</item>
        <item name="navigationIconTint">@color/xd_on_surface</item>
    </style>
</resources>
