<?xml version="1.0" encoding="utf-8"?>
<!--
    Shared styles. The colors (game_colors.xml), the light/dark base theme and the header
    settings (game_theme.xml) come from the game's folder in games/.
-->
<resources>
    <style name="Theme.DolphinXD" parent="Theme.DolphinXD.Base">
        <item name="colorPrimary">@color/xd_primary</item>
        <item name="colorOnPrimary">@color/xd_on_primary</item>
        <item name="colorPrimaryContainer">@color/xd_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/xd_on_primary_container</item>
        <item name="colorSecondary">@color/xd_accent_text</item>
        <item name="colorOnSecondary">@color/xd_on_accent</item>
        <item name="colorSecondaryContainer">@color/xd_accent_container</item>
        <item name="colorOnSecondaryContainer">@color/xd_on_accent_container</item>
        <item name="colorTertiary">@color/xd_accent_text</item>
        <item name="colorOnTertiary">@color/xd_on_accent</item>
        <item name="colorTertiaryContainer">@color/xd_accent_container</item>
        <item name="colorOnTertiaryContainer">@color/xd_on_accent_container</item>
        <item name="colorSurface">@color/xd_background</item>
        <item name="colorOnSurface">@color/xd_on_surface</item>
        <item name="colorSurfaceVariant">@color/xd_surface_stroke</item>
        <item name="colorOnSurfaceVariant">@color/xd_on_surface_variant</item>
        <item name="colorSurfaceContainerLowest">@color/xd_surface_lowest</item>
        <item name="colorSurfaceContainerLow">@color/xd_surface_low</item>
        <item name="colorSurfaceContainer">@color/xd_surface</item>
        <item name="colorSurfaceContainerHigh">@color/xd_surface_high</item>
        <item name="colorSurfaceContainerHighest">@color/xd_surface_highest</item>
        <item name="colorOutline">@color/xd_outline</item>
        <item name="colorOutlineVariant">@color/xd_outline_variant</item>
        <item name="android:colorBackground">@color/xd_background</item>
        <item name="android:windowBackground">@color/xd_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">@bool/xd_light_theme</item>
    </style>

    <style name="Theme.DolphinXD.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/xd_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/xd_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.DolphinXD</item>
    </style>

    <style name="XdSetupCard" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/xd_surface</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="strokeColor">@color/xd_surface_stroke</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="XdSetupCardTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/xd_on_surface</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="XdSetupCardBody">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:textColor">@color/xd_on_surface_muted</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="XdSetupCardStatus">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:textColor">@color/xd_on_surface</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="XdSectionTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textColor">@color/xd_accent_text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <style name="XdHint">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:textColor">@color/xd_on_surface_muted</item>
        <item name="android:textSize">13sp</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>

    <style name="XdToolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@android:color/transparent</item>
        <item name="titleTextColor">@color/xd_on_surface</item>
        <item name="navigationIconTint">@color/xd_on_surface</item>
    </style>
</resources>
