# The server's data the app downloads (dbc, Cameras, maps, vmaps, mmaps): AzerothCore's own, made
# from the 3.3.5a client and published at github.com/wowgaming/client-data. It has to match the
# core: this is the version the pinned core downloads itself (its
# apps/installer/includes/functions.sh, inst_download_client_data), whose mmaps are the core's
# MMAP_VERSION (20). CI downloads it, starts the world server on it and takes a character into
# the world (scripts/test-warcraft-server.sh). Kept apart from server-version.env so a change here
# doesn't rebuild the server.
SERVER_DATA_VERSION=v20.0
SERVER_DATA_URL=https://github.com/wowgaming/client-data/releases/download/v20.0/data.zip
SERVER_DATA_SIZE=1196168257
SERVER_DATA_SHA256=a3d4df635ae6c2c8f08052c32a79e0f806955150ad36b014a823dd08a32a4610
