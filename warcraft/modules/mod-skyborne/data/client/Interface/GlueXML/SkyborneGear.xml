<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">
	<!-- The gear button on the character creation screen (mod-skyborne): its icon and what it does are
	     SkyborneGear.lua's, from SkyborneGearData.lua. -->
	<Button name="SkyborneGearButton" parent="CharacterCreateConfigurationFrame">
		<Size x="38" y="38"/>
		<Layers>
			<Layer level="OVERLAY">
				<Texture name="$parentBorder" file="Interface\Buttons\UI-Quickslot2">
					<Size x="64" y="64"/>
					<Anchors>
						<Anchor point="CENTER" x="0" y="-1"/>
					</Anchors>
				</Texture>
			</Layer>
		</Layers>
		<HighlightTexture file="Interface\Buttons\ButtonHilight-Square" alphaMode="ADD"/>
	</Button>
</Ui>
