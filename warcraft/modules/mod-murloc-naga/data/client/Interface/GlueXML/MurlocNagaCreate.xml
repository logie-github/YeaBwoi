<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">
	<!-- More race buttons for the character creation screen (mod-murloc-naga): the game has ten, and with the
	     other race modules' and these two there are twenty. MurlocNagaCreate.lua gives them the names the screen
	     looks for, where it hasn't a button by that number already (this patch is read before the others'). -->
	<CheckButton name="MurlocNagaRaceButton11" parent="CharacterCreateConfigurationFrame" inherits="CharacterCreateRaceButtonTemplate" id="11" hidden="true"/>
	<CheckButton name="MurlocNagaRaceButton12" parent="CharacterCreateConfigurationFrame" inherits="CharacterCreateRaceButtonTemplate" id="12" hidden="true"/>
	<CheckButton name="MurlocNagaRaceButton13" parent="CharacterCreateConfigurationFrame" inherits="CharacterCreateRaceButtonTemplate" id="13" hidden="true"/>
	<CheckButton name="MurlocNagaRaceButton14" parent="CharacterCreateConfigurationFrame" inherits="CharacterCreateRaceButtonTemplate" id="14" hidden="true"/>
	<CheckButton name="MurlocNagaRaceButton15" parent="CharacterCreateConfigurationFrame" inherits="CharacterCreateRaceButtonTemplate" id="15" hidden="true"/>
	<CheckButton name="MurlocNagaRaceButton16" parent="CharacterCreateConfigurationFrame" inherits="CharacterCreateRaceButtonTemplate" id="16" hidden="true"/>
	<CheckButton name="MurlocNagaRaceButton17" parent="CharacterCreateConfigurationFrame" inherits="CharacterCreateRaceButtonTemplate" id="17" hidden="true"/>
	<CheckButton name="MurlocNagaRaceButton18" parent="CharacterCreateConfigurationFrame" inherits="CharacterCreateRaceButtonTemplate" id="18" hidden="true"/>
	<CheckButton name="MurlocNagaRaceButton19" parent="CharacterCreateConfigurationFrame" inherits="CharacterCreateRaceButtonTemplate" id="19" hidden="true"/>
	<CheckButton name="MurlocNagaRaceButton20" parent="CharacterCreateConfigurationFrame" inherits="CharacterCreateRaceButtonTemplate" id="20" hidden="true"/>
	<!-- Their icons, put on their buttons while the screen shows: the Worgen and Goblins' code, read after this,
	     gives every race not its own the game's sheet as the races are listed. -->
	<Frame name="MurlocNagaIcons" parent="CharacterCreate">
		<Scripts>
			<OnUpdate>
				MurlocNaga_Icons();
			</OnUpdate>
		</Scripts>
	</Frame>
</Ui>
