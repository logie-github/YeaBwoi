    <string name="wow_files_title">Game files</string>
    <string name="wow_files_client">Your client</string>
    <string name="wow_files_client_state">World of Warcraft 3.3.5a</string>
    <string name="wow_files_client_yes">Added · %1$s</string>
    <string name="wow_files_client_no">Not added</string>
    <string name="wow_files_client_body">Your own copy of the 3.3.5a (12340) client, enUS, about 17 GB: pick its folder (the one with Wow.exe and Data in it), or a zip of it. Move it onto the phone first: files in cloud folders can\'t be read this way. The app keeps its own copy, and checks it\'s build 12340.</string>
    <string name="wow_files_client_folder">Pick folder</string>
    <string name="wow_files_client_zip">Pick zip</string>
    <string name="wow_files_data">Server data</string>
    <string name="wow_files_data_yes">Ready</string>
    <string name="wow_files_data_no">Missing</string>
    <string name="wow_files_data_body">The world server needs dbc and maps from the client; vmaps add line of sight, and mmaps pathfinding, which creatures and bots need to move well. Download them ready-made, or make them from your client on this phone or on a PC.</string>
    <string name="wow_files_data_download">Download</string>
    <string name="wow_files_data_download_body">AzerothCore\'s ready-made server data for 3.3.5a, all five folders, in the version this server is built for: a %1$s download that unpacks to %2$s. It doesn\'t need your client. Best on Wi-Fi; if it stops, it carries on from where it got to.</string>
    <string name="wow_files_data_download_button">Download server data</string>
    <string name="wow_files_data_download_resume">Carry on downloading (%1$s of %2$s)</string>
    <string name="wow_files_data_download_update">Download the new server data</string>
    <string name="wow_files_data_downloaded">Downloaded</string>
    <string name="wow_files_data_downloaded_old">%1$s (this server wants %2$s)</string>
    <string name="wow_files_data_phone">On this phone</string>
    <string name="wow_files_data_phone_body">From the client added above. dbc, maps and vmaps take minutes; mmaps an hour or more, with the phone getting warm. It carries on with the app in the background.</string>
    <string name="wow_files_mmaps">Include mmaps</string>
    <string name="wow_files_mmaps_summary">Pathfinding: the long part</string>
    <string name="wow_files_extract">Make server data</string>
    <string name="wow_files_data_pc">On a Windows PC</string>
    <string name="wow_files_data_pc_body">Faster. Download WarcraftServerData-windows.zip from the same GitHub release as the app, unzip it on the PC, and drag your client\'s folder onto extract-server-data.bat. Copy the server-data.zip it makes to the phone, then import it here.</string>
    <string name="wow_files_data_import">Import server-data.zip</string>
    <string name="wow_files_space">Free on the phone: %1$s</string>

