<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <!-- The game (Winlator) draws with OpenGL ES. -->
    <uses-feature android:glEsVersion="0x00020000" android:required="true" />

    <!-- The server: ports 3724 and 8085, for the game on this phone and a PC's on the Wi-Fi. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- The server, and imports of gigabytes, keep running with the app in the background. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- The game (Winlator): its sound, rumble and network status. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_wotlk"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Warcraft"
        android:appCategory="game"
        android:isGame="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="fullUser"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:resizeableActivity="true" />

        <!-- The launcher icons, one per choice in the app (AppIcons): only one is enabled. -->
        <activity-alias
            android:name=".IconWotlk"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="true"
            android:icon="@mipmap/ic_wotlk"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconCataclysm"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_cata"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".WowUpdateActivity"
            android:exported="false"
            android:theme="@style/Theme.Warcraft.Overlay"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode" />

        <service
            android:name=".ServerService"
            android:exported="false" />

        <service
            android:name=".ImportService"
            android:exported="false" />

        <!-- Turtle WoW's realm and its installation jobs (com.logie.warcraft.turtle), apart from
             the ChromieCraft realm's ServerService. -->
        <service
            android:name=".turtle.TurtleService"
            android:exported="false" />

        <!-- The game: Winlator's screen (its X server with Wine and Box64 behind it), its controls
             editor, and the service that keeps the game alive in the background. Its own main
             screen stays, unlisted, for the code that refers to it. -->
        <activity
            android:name="com.winlator.XServerDisplayActivity"
            android:exported="false"
            android:theme="@style/AppThemeFullscreenDark"
            android:supportsPictureInPicture="true"
            android:launchMode="singleTask"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|density|navigation"
            android:screenOrientation="sensorLandscape" />
        <activity
            android:name="com.winlator.ControlsEditorActivity"
            android:exported="false"
            android:theme="@style/AppThemeFullscreenDark"
            android:screenOrientation="sensorLandscape" />
        <activity
            android:name="com.winlator.ExternalControllerBindingsActivity"
            android:exported="false"
            android:theme="@style/AppThemeDark"
            android:screenOrientation="sensor" />
        <activity
            android:name="com.winlator.MainActivity"
            android:exported="false"
            android:theme="@style/AppThemeDark"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|density|navigation" />
        <service
            android:name="com.winlator.services.ForegroundService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback"
            android:stopWithTask="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.filesprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
