# Turtle WoW's realm on the phone: Tortoise-WoW, the community restoration of Turtle WoW's 1.18.1
# server (MaNGOS family: realmd, mangosd), for the unmodified 1.18.1 (build 7272) client with its
# 2026-04-12 hotfixes. Built for Linux arm64 (musl, Alpine) by scripts/compile-tortoise.sh and
# packed by scripts/package-tortoise.sh; CI publishes the package as a release of its own
# (turtle-server-<hash>) that the app downloads when Turtle WoW is installed. Nothing here is
# shared with the ChromieCraft realm (warcraft/server-version.env).
ALPINE_VERSION=3.22
TORTOISE_REPO=https://github.com/tortoise-wow/tortoise-wow
TORTOISE_COMMIT=10393426efe4bbe1de3a31fd071ca36fae358bb6
# ACE (Tortoise's network framework), which Alpine doesn't package: built from its release.
ACE_VERSION=8.0.8
ACE_URL=https://github.com/DOCGroup/ACE_TAO/releases/download/ACE%2BTAO-8_0_8/ACE-8.0.8.tar.bz2
ACE_SHA256=d56f06d99508139e7a537122fdf52fb0c4d17805510094527643e1007857c421
# The only client build the realm accepts (Tortoise's src/realmd/RealmList.cpp).
CLIENT_BUILD=7272
