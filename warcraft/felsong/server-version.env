# Felsong's realm on the phone: LegionCore 7.3.5 (The Legion Preservation Project; TrinityCore
# family: bnetserver, worldserver), for the 7.3.5 client build 26972. Felsong's own core is closed
# (FELSONG.md); this is the closest public Legion 7.3.5 core, with the app's patches
# (warcraft/felsong/patches/). Built for Linux arm64 (musl, Alpine) by
# scripts/compile-legioncore.sh, packed by scripts/package-legioncore.sh. Nothing here is shared
# with the ChromieCraft realm (warcraft/server-version.env) or Turtle WoW's (warcraft/turtle/).
ALPINE_VERSION=3.22
LEGIONCORE_REPO=https://github.com/The-Legion-Preservation-Project/LegionCore-7.3.5
LEGIONCORE_COMMIT=fed58f79c498521836612acd12009e9fa9e60e31
# Its world and hotfixes databases (a release of the project; the core names these files in
# revision_data.h.in.cmake), checked against their SHA-256.
LEGIONCORE_DB_URL=https://github.com/The-Legion-Preservation-Project/LegionCore-7.3.5/releases/download/LegionCore735.24101/LegionCore_full_735.26972_2024_10_23.7z
LEGIONCORE_DB_SHA256=cf681e1fb2e7443daab2a5db04f4efa2fc53cc485ea8de6b6ec3d60d569c2696
# The only client build the realm is set up for (bnetserver.conf's Game.Build.Version).
CLIENT_BUILD=26972
