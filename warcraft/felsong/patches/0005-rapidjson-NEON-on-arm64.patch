From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: World of Warcraft <warcraft@users.noreply.github.com>
Date: Fri, 16 Oct 2026 06:17:43 +0000
Subject: [PATCH 5/7] rapidjson: NEON on arm64

RAPIDJSON_SSE2 was set for every processor, and <emmintrin.h> doesn't build for arm64. NEON
there, as TrinityCore has since.
---
 dep/rapidjson/CMakeLists.txt | 12 +++++++++++-
 1 file changed, 11 insertions(+), 1 deletion(-)

diff --git a/dep/rapidjson/CMakeLists.txt b/dep/rapidjson/CMakeLists.txt
index 7a114c2..7a5337f 100644
--- a/dep/rapidjson/CMakeLists.txt
+++ b/dep/rapidjson/CMakeLists.txt
@@ -8,6 +8,16 @@ target_include_directories(rapidjson
 target_compile_definitions(rapidjson
   INTERFACE
     -DRAPIDJSON_HAS_STDSTRING
-    -DRAPIDJSON_SSE2
     -DRAPIDJSON_48BITPOINTER_OPTIMIZATION=0
     -DRAPIDJSON_ASSERT=WPAssert)
+
+# Its SIMD string scanning: SSE2 on x86, NEON on arm64 (SSE2 doesn't build there).
+if(CMAKE_SYSTEM_PROCESSOR MATCHES "aarch64|arm64|ARM64")
+  target_compile_definitions(rapidjson
+    INTERFACE
+      -DRAPIDJSON_NEON)
+else()
+  target_compile_definitions(rapidjson
+    INTERFACE
+      -DRAPIDJSON_SSE2)
+endif()
