# The custom races (the launcher's Races switch): Medviten's mod-worgoblin-high-elf, whose modpaks
# (the ones in warcraft/races/manifest) scripts/build-races.py turns into the game's tables (DBC)
# and the world database's SQL, with Thorium's DBC layouts; its client files (models, textures,
# sounds, the character creation screen) go into the client as they are. Built and published by
# CI (scripts/build-races-package.sh) as a release of its own, which the app downloads when the
# races are turned on. The server's code for the races is warcraft/patches/azerothcore/0009-*.
RACES_REPO=https://github.com/Medviten/mod-worgoblin-high-elf
RACES_COMMIT=52fd0062c8a1430e90171fdedd4f827529837939
THORIUM_REPO=https://github.com/suprsokr/thorium
THORIUM_COMMIT=0e163761ab39102e728499220975668482381842
# The client files of races left out of the manifest (Kul Tiran), not packed.
RACES_CLIENT_EXCLUDE=kultiran
