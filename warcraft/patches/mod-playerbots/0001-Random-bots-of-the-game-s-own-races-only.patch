From cc8c37462a69ce5b7259470c2f1ba579736c1f9c Mon Sep 17 00:00:00 2001
From: World of Warcraft <warcraft@users.noreply.github.com>
Date: Tue, 13 Oct 2026 00:11:26 +0000
Subject: [PATCH] Random bots of the game's own races only

The World of Warcraft app can add custom races to its realm (Goblin, Worgen and more). Those are
for players: random bots keep to the ten races the game has.
---
 src/Bot/Factory/RandomPlayerbotFactory.cpp | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/src/Bot/Factory/RandomPlayerbotFactory.cpp b/src/Bot/Factory/RandomPlayerbotFactory.cpp
index 23046e1..0ae243f 100644
--- a/src/Bot/Factory/RandomPlayerbotFactory.cpp
+++ b/src/Bot/Factory/RandomPlayerbotFactory.cpp
@@ -64,6 +64,15 @@ constexpr RandomPlayerbotFactory::NameRaceAndGender RandomPlayerbotFactory::Comb
 
 bool RandomPlayerbotFactory::IsValidRaceClassCombination(uint8 race, uint8 cls, uint32 expansion)
 {
+    // Random bots are of the game's own ten races only: the custom races (when the server has
+    // them) are for players.
+    constexpr uint32 originalRaces = (1 << (RACE_HUMAN - 1)) | (1 << (RACE_ORC - 1)) | (1 << (RACE_DWARF - 1)) |
+                                     (1 << (RACE_NIGHTELF - 1)) | (1 << (RACE_UNDEAD_PLAYER - 1)) |
+                                     (1 << (RACE_TAUREN - 1)) | (1 << (RACE_GNOME - 1)) | (1 << (RACE_TROLL - 1)) |
+                                     (1 << (RACE_BLOODELF - 1)) | (1 << (RACE_DRAENEI - 1));
+    if (race < RACE_HUMAN || race > 32 || !(originalRaces & (1u << (race - 1))))
+        return false;
+
     // skip expansion races if not playing with expansion
     if (expansion < EXPANSION_THE_BURNING_CRUSADE && (race == RACE_BLOODELF || race == RACE_DRAENEI))
         return false;
