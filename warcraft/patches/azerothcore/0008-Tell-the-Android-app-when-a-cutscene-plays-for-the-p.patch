From 65427ba8a18d58f6790a04eae68989abefa4193b Mon Sep 17 00:00:00 2001
From: World of Warcraft <warcraft@users.noreply.github.com>
Date: Mon, 12 Oct 2026 23:19:38 +0000
Subject: [PATCH] Tell the Android app when a cutscene plays for the phone's
 player

The World of Warcraft app's touch controls open the bags with a hold, and skip a cutscene with the
same hold while one plays (Escape). With WOW_CUTSCENE_FILE set, a cinematic or a movie starting for
the client on 127.0.0.1 writes its kind and the time; its end (the client's complete-cinematic or
complete-movie, which the server now takes, or a logout) writes "-".
---
 src/server/game/Entities/Player/Player.cpp  |  2 ++
 src/server/game/Handlers/MiscHandler.cpp    | 24 +++++++++++++++++++++
 src/server/game/Server/Protocol/Opcodes.cpp |  2 +-
 src/server/game/Server/WorldSession.cpp     |  1 +
 src/server/game/Server/WorldSession.h       |  2 ++
 5 files changed, 30 insertions(+), 1 deletion(-)

diff --git a/src/server/game/Entities/Player/Player.cpp b/src/server/game/Entities/Player/Player.cpp
index 138e7eab49..3297982c2b 100644
--- a/src/server/game/Entities/Player/Player.cpp
+++ b/src/server/game/Entities/Player/Player.cpp
@@ -5879,6 +5879,7 @@ void Player::SendCinematicStart(uint32 CinematicSequenceId) const
     WorldPacket data(SMSG_TRIGGER_CINEMATIC, 4);
     data << uint32(CinematicSequenceId);
     SendDirectMessage(&data);
+    m_session->NoteCutsceneForTouch('c');
 }
 
 void Player::SendMovieStart(uint32 MovieId)
@@ -5886,6 +5887,7 @@ void Player::SendMovieStart(uint32 MovieId)
     WorldPacket data(SMSG_TRIGGER_MOVIE, 4);
     data << uint32(MovieId);
     SendDirectMessage(&data);
+    m_session->NoteCutsceneForTouch('m');
 }
 
 void Player::CheckAreaExploreAndOutdoor()
