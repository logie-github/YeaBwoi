 #include <zlib.h>
 
 #include "Corpse.h"
@@ -554,6 +555,23 @@ static void NoteSelectionForTouch(WorldSession* session, Player* player, ObjectG
     }
 }
 
+// World of Warcraft app (Android): a hold on the screen opens the bags, or skips a cutscene while one
+// plays (Escape). The app names the file (WOW_CUTSCENE_FILE); a cinematic or a movie starting for the
+// phone's own player writes "<c|m> <unix time>", its end "- <unix time>".
+void WorldSession::NoteCutsceneForTouch(char kind)
+{
+    static char const* path = std::getenv("WOW_CUTSCENE_FILE");
+    if (!path || !*path || GetRemoteAddress() != "127.0.0.1")
+        return;
+    std::string tmp = std::string(path) + ".tmp";
+    if (FILE* file = std::fopen(tmp.c_str(), "w"))
+    {
+        std::fprintf(file, "%c %lld\n", kind, static_cast<long long>(std::time(nullptr)));
+        std::fclose(file);
+        std::rename(tmp.c_str(), path);
+    }
+}
+
 void WorldSession::HandleSetSelectionOpcode(WorldPacket& recv_data)
 {
     ObjectGuid guid;
@@ -965,6 +983,12 @@ void WorldSession::HandleCompleteCinematic(WorldPacket& /*recv_data*/)
 {
     // End the current cinematic and restore the normal player view
     GetPlayer()->GetCinematicMgr().EndCinematic();
+    NoteCutsceneForTouch('-');
+}
+
+void WorldSession::HandleCompleteMovie(WorldPacket& /*recv_data*/)
+{
+    NoteCutsceneForTouch('-');
 }
 
 void WorldSession::HandleNextCinematicCamera(WorldPacket& /*recv_data*/)
