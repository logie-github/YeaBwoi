new file mode 100644
index 0000000000..c4f446d488
--- /dev/null
+++ b/src/server/scripts/Custom/custom_races.cpp
@@ -0,0 +1,138 @@
+/*
+ * This file is part of the AzerothCore Project. See AUTHORS file for Copyright information
+ *
