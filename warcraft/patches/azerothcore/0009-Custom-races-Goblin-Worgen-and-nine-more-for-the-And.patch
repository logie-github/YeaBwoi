diff --git a/src/server/game/Entities/Player/PlayerTaxi.cpp b/src/server/game/Entities/Player/PlayerTaxi.cpp
index 6cf62c95de..3e07143ae3 100644
--- a/src/server/game/Entities/Player/PlayerTaxi.cpp
+++ b/src/server/game/Entities/Player/PlayerTaxi.cpp
@@ -67,6 +67,31 @@ void PlayerTaxi::InitTaxiNodesForLevel(uint32 race, uint32 chrClass, uint8 level
         case RACE_DRAENEI:
             SetTaximaskNode(94);
             break;     // Draenei
+        // The custom races: the capital and hub of the home they start in.
+        case RACE_GOBLIN:
+        case RACE_MAGHARORC:
+        case RACE_OGRE:
+        case RACE_ZANDALARITROLL:
+            SetTaximaskNode(23);
+            break;     // Orgrimmar
+        case RACE_WORGEN:
+            SetTaximaskNode(26);
+            SetTaximaskNode(27);
+            break;     // Teldrassil and Rut'theran
+        case RACE_HIGHELF:
+        case RACE_ALLIANCEPANDAREN:
+            SetTaximaskNode(2);
+            break;     // Stormwind
+        case RACE_DARKIRONDWARF:
+            SetTaximaskNode(6);
+            break;     // Ironforge
+        case RACE_VULPERA:
+        case RACE_HORDEPANDAREN:
+            SetTaximaskNode(22);
+            break;     // Thunder Bluff
+        case RACE_BROKEN:
+            SetTaximaskNode(94);
+            break;     // The Exodar
     }
 
     // new continent starting masks (It will be accessible only at new map)
diff --git a/src/server/game/Globals/ObjectMgr.cpp b/src/server/game/Globals/ObjectMgr.cpp
index 61afa50914..c5c8481be1 100644
--- a/src/server/game/Globals/ObjectMgr.cpp
+++ b/src/server/game/Globals/ObjectMgr.cpp
@@ -1890,10 +1890,21 @@ uint32 ObjectMgr::GetModelForShapeshift(ShapeshiftForm form, Player* player) con
 {
     uint8 customizationID;
 
-    if (player->GetTeamId() == TEAM_ALLIANCE)
-        customizationID = player->GetByteValue(PLAYER_BYTES, 3); // Use Hair Color
-    else
-        customizationID = player->GetByteValue(PLAYER_BYTES, 0); // Use Skin Color
+    // Furred races' forms follow their skin (fur) colour, the others' their hair colour. Of the
+    // game's own races only Tauren and Night Elves have forms here, as before; the custom races'
+    // forms (player_shapeshift_model) are made the same way.
+    switch (player->getRace())
+    {
+        case RACE_TAUREN:
+        case RACE_VULPERA:
+        case RACE_ALLIANCEPANDAREN:
+        case RACE_HORDEPANDAREN:
+            customizationID = player->GetByteValue(PLAYER_BYTES, 0); // Use Skin Color
+            break;
+        default:
+            customizationID = player->GetByteValue(PLAYER_BYTES, 3); // Use Hair Color
+            break;
+    }
 
     // getGender() tracks the active display model; real gender lives in PLAYER_BYTES_3
     uint8 gender = player->GetByteValue(PLAYER_BYTES_3, PLAYER_BYTES_3_OFFSET_GENDER);
