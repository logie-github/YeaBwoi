+ * FITNESS FOR A PARTICULAR PURPOSE. See the GNU Affero General Public License for
+ * more details.
+ *
+ * You should have received a copy of the GNU General Public License along
+ * with this program. If not, see <http://www.gnu.org/licenses/>.
+ */
+
+/*
+ * The custom races' own rules (the World of Warcraft app's custom races), from Medviten's
+ * mod-worgoblin-high-elf (AGPL-3.0): the Goblin racials and the Worgen's Running Wild.
+ * They do nothing while the races are off: no character has the races, and the spells
+ * aren't in the game.
+ */
+
+#include "Player.h"
+#include "ScriptMgr.h"
+#include "SpellInfo.h"
+#include "SpellScript.h"
+
+enum CustomRaceSpells
+{
+    SPELL_BEST_DEALS_ANYWHERE   = 69044,  // Goblin: everything 20% cheaper
+
+    SPELL_APPRENTICE_RIDING     = 33388,
+    SPELL_JOURNEYMAN_RIDING     = 33391,
+    SPELL_RUNNING_WILD_MALE     = 87840,  // Worgen: Running Wild, at apprentice riding
+    SPELL_RUNNING_WILD_FEMALE   = 87841,
+    SPELL_RUNNING_WILD_MALE_2   = 110010, // ...at journeyman riding
+    SPELL_RUNNING_WILD_FEMALE_2 = 110011,
+};
+
+class custom_races_goblin : public PlayerScript
+{
+public:
+    custom_races_goblin() : PlayerScript("custom_races_goblin", { PLAYERHOOK_ON_GET_REPUTATION_PRICE_DISCOUNT }) { }
+
+    using PlayerScript::OnPlayerGetReputationPriceDiscount;
+
+    void OnPlayerGetReputationPriceDiscount(Player const* player, FactionTemplateEntry const* factionTemplate, float& discount) override
+    {
+        if (!factionTemplate || !factionTemplate->faction)
+            return;
+
+        if (player->HasSpell(SPELL_BEST_DEALS_ANYWHERE))
+            discount *= 0.8f;
+    }
+};
+
+// Goblin: Rocket Barrage, its damage from the caster's level, spell power and attack power.
+class spell_rocket_barrage : public SpellScript
+{
+    PrepareSpellScript(spell_rocket_barrage);
+
+    void HandleDamage(SpellEffIndex /*effIndex*/)
+    {
+        Unit* caster = GetCaster();
+        if (!caster)
+            return;
+
+        int32 damage = caster->GetLevel() * 2;
+        damage += caster->SpellBaseDamageBonusDone(GetSpellInfo()->GetSchoolMask()) * 0.429f;
+        damage += caster->GetTotalAttackPowerValue(caster->getClass() != CLASS_HUNTER ? BASE_ATTACK : RANGED_ATTACK) * 0.25f;
+        SetEffectValue(damage);
+    }
+
+    void Register() override
+    {
+        OnEffectLaunchTarget += SpellEffectFn(spell_rocket_barrage::HandleDamage, EFFECT_0, SPELL_EFFECT_SCHOOL_DAMAGE);
+    }
+};
+
+// Worgen: Running Wild (running on all fours as a mount), with free riding at 20 and 40.
+class custom_races_worgen_running_wild : public PlayerScript
+{
+public:
+    custom_races_worgen_running_wild() : PlayerScript("custom_races_worgen_running_wild", { PLAYERHOOK_ON_LOGIN, PLAYERHOOK_ON_LEVEL_CHANGED }) { }
+
+    void OnPlayerLogin(Player* player) override { Update(player); }
+    void OnPlayerLevelChanged(Player* player, uint8 /*oldLevel*/) override { Update(player); }
+
+private:
+    static uint32 RunningWild(Player const* player, bool journeyman)
+    {
+        bool male = player->getGender() == GENDER_MALE;
+        if (journeyman)
+            return male ? SPELL_RUNNING_WILD_MALE_2 : SPELL_RUNNING_WILD_FEMALE_2;
+        return male ? SPELL_RUNNING_WILD_MALE : SPELL_RUNNING_WILD_FEMALE;
+    }
+
+    static void Keep(Player* player, uint32 wanted, uint32 other)
+    {
+        if (player->HasSpell(other))
+            player->removeSpell(other, SPEC_MASK_ALL, false);
+        if (!player->HasSpell(wanted))
+            player->learnSpell(wanted);
+    }
+
+    static void Update(Player* player)
+    {
+        if (player->getRace() != RACE_WORGEN)
+            return;
+
+        // Death knights start past both: the fast one straight away.
+        if (player->getClass() == CLASS_DEATH_KNIGHT)
+        {
+            Keep(player, RunningWild(player, true), RunningWild(player, false));
+            return;
+        }
+
+        uint8 level = player->GetLevel();
+        if (level >= 20 && !player->HasSpell(SPELL_APPRENTICE_RIDING))
+            player->learnSpell(SPELL_APPRENTICE_RIDING);
+        if (level >= 40 && !player->HasSpell(SPELL_JOURNEYMAN_RIDING))
+            player->learnSpell(SPELL_JOURNEYMAN_RIDING);
+
+        bool journeyman = player->HasSpell(SPELL_JOURNEYMAN_RIDING);
+        if (!journeyman && !player->HasSpell(SPELL_APPRENTICE_RIDING))
+            return;
+        Keep(player, RunningWild(player, journeyman), RunningWild(player, !journeyman));
+    }
+};
+
+void AddSC_custom_races()
+{
+    new custom_races_goblin();
+    RegisterSpellScript(spell_rocket_barrage);
+    new custom_races_worgen_running_wild();
+}
