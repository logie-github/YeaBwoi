+Trainer::Trainer* ObjectMgr::GetTrainer(uint32 creatureId, Player const* player)
+{
+    Trainer::Trainer* trainer = GetTrainer(creatureId);
+    if (!trainer || !player || trainer->GetTrainerType() != Trainer::Type::Class)
+        return trainer;
+
+    // The app's new race and class pairs (mod-allied-races, on the realm whose AlliedRaces.Enable is on):
+    // another class's trainers train them, as their own class's trainer whose spells suit them most does.
+    uint8 host = 0;
+    switch (player->getRace())
+    {
+        case RACE_UNDEAD_PLAYER: host = player->getClass() == CLASS_PALADIN ? CLASS_PRIEST : 0; break;
+        case RACE_HUMAN:         host = player->getClass() == CLASS_HUNTER ? CLASS_WARRIOR : 0; break;
+        case RACE_DWARF:         host = player->getClass() == CLASS_SHAMAN ? CLASS_PRIEST : 0; break;
+        case RACE_GNOME:         host = player->getClass() == CLASS_PRIEST ? CLASS_MAGE : 0; break;
+        case RACE_ORC:           host = player->getClass() == CLASS_MAGE ? CLASS_WARLOCK : 0; break;
+        case RACE_TROLL:         host = player->getClass() == CLASS_WARLOCK ? CLASS_MAGE : 0; break;
+        default: break;
+    }
+    if (!host || trainer->GetTrainerRequirement() != host || !sConfigMgr->GetOption<bool>("AlliedRaces.Enable", false))
+        return trainer;
+
+    auto own = _classTrainers.find(player->getClass());
+    if (own == _classTrainers.end())
+        return trainer;
+
+    Trainer::Trainer* best = nullptr;
+    std::size_t bestCount = 0;
+    for (Trainer::Trainer const* candidate : own->second)
+    {
+        std::size_t count = std::count_if(candidate->GetSpells().begin(), candidate->GetSpells().end(),
+            [player](Trainer::Spell const& spell) { return player->IsSpellFitByClassAndRace(spell.SpellId); });
+        if (count > bestCount || (count == bestCount && best && candidate->_trainerId < best->_trainerId))
+        {
+            best = Acore::Containers::MapGetValuePtr(_trainers, candidate->_trainerId);
+            bestCount = count;
+        }
+    }
+    return best ? best : trainer;
+}
