From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: World of Warcraft <warcraft@users.noreply.github.com>
Date: Sun, 11 Oct 2026 16:19:22 +0000
Subject: [PATCH 3/5] Print the CPU affinity mask without glibc's __cpu_mask

__cpu_mask is glibc's own name for the type cpu_set_t is made of (unsigned long); musl doesn't have
it.
---
 src/common/Threading/ProcessPriority.cpp | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/common/Threading/ProcessPriority.cpp b/src/common/Threading/ProcessPriority.cpp
index fca37f63a7..f163f18fe4 100644
--- a/src/common/Threading/ProcessPriority.cpp
+++ b/src/common/Threading/ProcessPriority.cpp
@@ -90,7 +90,7 @@ void SetProcessPriority(std::string const& logChannel, uint32 affinity, bool hig
         {
             CPU_ZERO(&mask);
             sched_getaffinity(0, sizeof(mask), &mask);
-            LOG_INFO(logChannel, "Using processors (bitmask, hex): {:x}", *(__cpu_mask*)(&mask));
+            LOG_INFO(logChannel, "Using processors (bitmask, hex): {:x}", *reinterpret_cast<unsigned long*>(&mask));
         }
     }
 
