+Trainer::Trainer* ObjectMgr::GetTrainer(uint32 creatureId, Player const* player)
+{
+    Trainer::Trainer* trainer = GetTrainer(creatureId);
+    // The app's undead paladins (mod-allied-races, on the realm whose AlliedRaces.Enable is on): every
+    // priest class trainer trains them as a paladin trainer does, with the paladin trainer whose spells
+    // suit them most (the Horde's, whose paladins' spells are theirs too).
+    if (!trainer || !player || player->getClass() != CLASS_PALADIN || player->getRace() != RACE_UNDEAD_PLAYER ||
+        trainer->GetTrainerType() != Trainer::Type::Class || trainer->GetTrainerRequirement() != CLASS_PRIEST ||
+        !sConfigMgr->GetOption<bool>("AlliedRaces.Enable", false))
+        return trainer;
+
+    auto paladins = _classTrainers.find(CLASS_PALADIN);
+    if (paladins == _classTrainers.end())
+        return trainer;
+
+    Trainer::Trainer* best = nullptr;
+    std::size_t bestCount = 0;
+    for (Trainer::Trainer const* candidate : paladins->second)
+    {
+        std::size_t count = std::count_if(candidate->GetSpells().begin(), candidate->GetSpells().end(),
+            [player](Trainer::Spell const& spell) { return player->IsSpellFitByClassAndRace(spell.SpellId); });
+        if (count > bestCount || (count == bestCount && best && candidate->_trainerId < best->_trainerId))
+        {
+            best = Acore::Containers::MapGetValuePtr(_trainers, candidate->_trainerId);
+            bestCount = count;
+        }
+    }
+    return best ? best : trainer;
+}
