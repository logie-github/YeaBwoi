+    /**
+     * World of Warcraft app: the processes of this app's user whose environment has [name]=[value]
+     * (one a session or a local realm put in its programs' environment, which Wine passes on to the
+     * programs they start), never this process.
+     */
+    public static List<Integer> findProcessesWithEnv(String name, String value) {
+        ArrayList<Integer> result = new ArrayList<>();
+        byte[] wanted = (name+"="+value).getBytes();
+        File[] entries = new File("/proc").listFiles();
+        if (entries == null) return result;
+        int self = Process.myPid();
+        for (File entry : entries) {
+            String fileName = entry.getName();
+            if (fileName.isEmpty() || !Character.isDigit(fileName.charAt(0))) continue;
+            int pid;
+            try { pid = Integer.parseInt(fileName); }
+            catch (NumberFormatException e) { continue; }
+            if (pid == self) continue;
+            byte[] environ;
+            try (FileInputStream input = new FileInputStream(new File(entry, "environ"))) {
+                java.io.ByteArrayOutputStream bytes = new java.io.ByteArrayOutputStream();
+                byte[] buffer = new byte[8192];
+                int read;
+                while ((read = input.read(buffer)) > 0) bytes.write(buffer, 0, read);
+                environ = bytes.toByteArray();
+            }
+            catch (IOException | SecurityException e) { continue; }
+            int start = 0;
+            for (int i = 0; i <= environ.length; i++) {
+                if (i == environ.length || environ[i] == 0) {
+                    if (i - start == wanted.length) {
+                        boolean same = true;
+                        for (int j = 0; j < wanted.length; j++) {
+                            if (environ[start + j] != wanted[j]) { same = false; break; }
+                        }
+                        if (same) { result.add(pid); break; }
+                    }
+                    start = i + 1;
+                }
+            }
+        }
+        return result;
+    }
