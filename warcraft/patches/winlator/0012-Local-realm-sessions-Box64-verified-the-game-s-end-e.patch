From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: World of Warcraft <warcraft@users.noreply.github.com>
Date: Sat, 24 Oct 2026 19:30:07 +0000
Subject: [PATCH] Local realm sessions: Box64 verified, the game's end ends its
 session, crashes end

Box64's version was extracted over the runtime's binary in place, the
result ignored and the version recorded anyway: with a Box64 still
running the write fails (ETXTBSY) and the other version stays while
this one is recorded. Local realms' modern clients fail their start-up
protection on the stock Box64 ("Game Initialization Failed!"). The
version's binary is now staged (once per app build), compared with the
installed one at every start and put in place by a rename; the version
is recorded only once it's installed. A local realm's session logs which
Box64 it runs, its game's windows, and Box64's word on a fault
(BOX64_SHOWSEGV); the realm can end it when its game has ended
(endFromRealm). A local realm's prefix has Wine's crash dialog off, so a
crash ends the program with its code instead of hanging unseen.
---
 .../java/com/winlator/WinePrefixSetup.java    |  5 ++
 .../com/winlator/XServerDisplayActivity.java  | 29 +++++++++-
 .../com/winlator/core/GeneralComponents.java  | 15 +++++
 .../GuestProgramLauncherComponent.java        | 55 ++++++++++++++++++-
 4 files changed, 98 insertions(+), 6 deletions(-)

diff --git a/app/src/main/java/com/winlator/WinePrefixSetup.java b/app/src/main/java/com/winlator/WinePrefixSetup.java
index dbbd1a3..6c11bd7 100644
--- a/app/src/main/java/com/winlator/WinePrefixSetup.java
+++ b/app/src/main/java/com/winlator/WinePrefixSetup.java
@@ -345,6 +345,11 @@ public class WinePrefixSetup {
         WinePrefixSetup setup = forContainer(context, container, new EnvVars());
         setup.setupWineSystemFiles(false);
         setup.changeWineAudioDriver(false);
+        // (a crash ends the program, its code written, instead of Wine's crash dialog holding it
+        // behind a screen no one sees: the realm's servers and its game alike)
+        try (WineRegistryEditor editor = new WineRegistryEditor(new File(RootFS.find(context).getRootDir(), RootFS.WINEPREFIX+"/user.reg"))) {
+            editor.setDwordValue("Software\\Wine\\WineDbg", "ShowCrashDialog", 0);
+        }
         GuestProgramLauncherComponent.prepareBox64(context, box64Version);
         RootFS rootFS = RootFS.find(context);
         File shm = new File(rootFS.getRootDir(), "/tmp/shm");
diff --git a/app/src/main/java/com/winlator/XServerDisplayActivity.java b/app/src/main/java/com/winlator/XServerDisplayActivity.java
index 74d9b3b..34f80a1 100644
--- a/app/src/main/java/com/winlator/XServerDisplayActivity.java
+++ b/app/src/main/java/com/winlator/XServerDisplayActivity.java
@@ -277,6 +277,9 @@ public class XServerDisplayActivity extends AppCompatActivity implements Navigat
 
             @Override
             public void onMapWindow(Window window) {
+                // World of Warcraft app: a local realm's game's windows in its log (an "ERROR" box says which).
+                if (getIntent().getBooleanExtra("local_server_session", false) && window.isRenderable() && !window.getClassName().isEmpty())
+                    writeSessionLog("[app] window \""+window.getName()+"\" ("+window.getClassName()+")");
                 if (!flags[0] && window.isRenderable() && !window.getClassName().isEmpty()) {
