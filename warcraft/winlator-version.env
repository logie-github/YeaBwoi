# The game's runtime: Winlator (https://github.com/brunodev85/winlator, LGPL-2.1), its Android app
# (Wine, Box64, the graphics drivers, its X server) at the commit Winlator 11.2's repository pins
# its `app` submodule to. scripts/prepare-winlator.sh brings it into the app as a library module.
WINLATOR_VERSION=11.2
WINLATOR_APP_REPO=https://github.com/brunodev85/winlator-app
WINLATOR_APP_COMMIT=a030f552f452158a2db64fdb32b490fa19c0b48d
# Where Winlator's runtime has its install path compiled in, and where this app puts it: the same
# length, so the rewrite keeps every string and ELF header in place.
WINLATOR_ROOTFS_PATH=/data/data/com.winlator/files/rootfs
APP_ROOTFS_PATH=/data/data/com.logie.warcraft/rootfs
