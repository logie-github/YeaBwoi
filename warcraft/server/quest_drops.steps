cmd .questdrops near 1890
kill-loot 1890
at-least 9 loot item 6281
# Out of the fight, away from the skeletons, so the character can log out (the realm keeps one in
# combat).
go 0 1676.7 1678.3 121.7
cmd .combatstop
wait 2
