# Brill: The Forgotten Shadow Chapel (mod-brill-home, tools/town/chapel.py), ChromieCraft's realm: Brill
# Endures granted (the project's stage 1, <2:1>: the chapel's stages are invisibility kind 2), Dark Cleric
# Mirelle Vane at the meeting house north of the cemetery. A Place for the Unforgotten (the wall of names, a
# pile of rubble, the altar, the gravekeeper asked); Stone, Timber, and Shadow (a stone block at Cold Hearth
# Manor, Rudd Carver's lantern frames, the doors); The Book of Names (a page at Garren's Haunt, Willem Vale's
# grave, Elsbeth Vale's story and the choice: his name added to the wall, the mark q971107; the lectern); The
# Weight of Faith (a chalk sigil, the Agamands' nursery chest, Corven's question answered: q971109); The Bell
# for the Forgotten (the bell in Garren's barn, the smithy, the hoist, the opening). Each quest moves the
# stage on; then the chapel open (<2:6>), the house's chapel set bought from Halden (<2:7>, the mark q971112)
# and the daily, Names to Remember, offered. (Kills and the long counts are filled with .quest complete.)
cmd .levelup 11
cmd .modify money 100000
cmd .brilltown grant 971000
# Stage 1: Mirelle at the meeting house's yard.
go 0 2385.0 392.2 35.9
wait 2
cmd .brilltown state
has <2:1>
talk 971100
accept 971100 971100
# A Place for the Unforgotten.
go 0 2397.17 394.96 34.4
cmd .brilltown use
has Brill town: used 971101
expect credit 971100 971114 1/1
go 0 2393.48 393.75 34.4
cmd .brilltown use
has Brill town: used 971102
expect credit 971100 971115 1/6
go 0 2403.42 401.34 35.3
cmd .brilltown use
has Brill town: used 971103
expect credit 971100 971116 1/3
go 0 2360.5 342.5 38.5
talk 970300
select 970300 meeting house past the cemetery
expect credit 971100 971117 1/1
cmd .quest complete 971100
go 0 2385.0 392.2 35.9
talk 971100
reward 971100 971100
expect rewarded 971100
wait 2
cmd .brilltown state
has <2:2>
# Stone, Timber, and Shadow: Halden, there from stage 2.
go 0 2383.5 397.2 36.0
talk 971101
accept 971101 971101
