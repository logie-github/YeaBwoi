# Wrath Remix's prologue, played by CI as a new Timerunner (auth_check.py script, on the Remix
# realm): Moratari's first quests in the Caverns of Time, the Bazaar in Crystalsong Forest, a
# purchase from Alurmi, Eternus' choice of coast, and the first chapter. The anomalies are killed
# with a game master's `.damage` (the character's blows, so it gets the kills).

cmd .remix
expect chapter 0 (the prologue)

# The starter kit and the class's abilities, a moment after the first login (the client checks
# what the realm wrote down at the end).
wait 3

# WRM-001, The Weight of Time: the three time-echoes.
talk 770001
expect quest 77001
accept 770001 77001
go 1 -8369.7 -4316.0 -208.3
talk 770021
expect credit 77001 770021
go 1 -8360.7 -4313.0 -208.3
talk 770022
go 1 -8351.7 -4316.0 -208.3
talk 770023
expect credit 77001 770023
go 1 -8360.7 -4326.0 -208.3
reward 770001 77001
expect rewarded 77001

# WRM-002, An Agreement Across the Hours: Andormu's terms, Eternus' reply.
talk 770001
accept 770001 77002
go 1 -8356.5 -4322.5 -208.3
reward 770003 77002
expect rewarded 77002

# WRM-003, A Small Demonstration: Moratari lets the anomalies through, one at a time (each one
# killed brings the next, three in all).
go 1 -8360.7 -4326.0 -208.3
talk 770001
accept 770001 77003
talk 770001
expect Let the anomalies through
select 770001 anomalies
expect through the seams
# (a moment for each to come through)
wait 2
kill 770031
expect credit 77003 770032 1/3
wait 2
kill 770031
expect credit 77003 770032 2/3
wait 2
kill 770031
expect credit 77003 770032 3/3
wait 2
cmd .remix guid 770031
expect no creature 770031
reward 770001 77003
expect rewarded 77003

# WRM-004, The Bazaar Beneath the Violet Sky.
talk 770001
accept 770001 77004
talk 770001
select 770001 Infinite Bazaar
expect arrived on map 571
go 571 5693.5 1015.5 175.0
talk 770005
expect credit 77004 770005
go 571 5698.0 1009.0 175.0
talk 770008
expect credit 77004 770008
go 571 5700.0 1021.0 175.0
reward 770002 77004
expect rewarded 77004

# Alurmi's Bronze: 425 after the prologue's quests (summoned anomalies give none), a heirloom for 300
# (one the warrior's kit hasn't got).
go 571 5693.5 1015.5 175.0
talk 770005
expect You carry 425 Bronze
select 770005 Heirloom armor
expect Tattered Dreadmist Mantle: 300 Bronze
select 770005 Tattered Dreadmist Mantle
expect You carry 125 Bronze

# WRM-005, The War We Must Remember: Eternus sends the Timerunner to Valiance Keep.
go 571 5700.0 1021.0 175.0
talk 770002
accept 770002 77005
talk 770002
select 770002 Valiance Keep
wait 3
go 571 2298.7 5231.5 11.9
reward 770001 77005
expect rewarded 77005
cmd .remix
expect chapter 1

# Borean Tundra's creatures at Chapter I's levels.
cmd .remix band
expect band: Borean Tundra
